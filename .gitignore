# Всё, что не перечислено здесь, попадает в Git автоматически
# (новые сцены в translation/scenes/ подхватываются сами).

# --- Окружение и мусор ---
.venv/
__pycache__/
*.pyc
.DS_Store
*.log

# --- Сторонние инструменты (ставятся scripts/setup-tools.sh) ---
/vendor/

# --- Артефакты сборки: извлечённые ресурсы, патчи, сохранения эмулятора ---
/build/
/analysis/

# --- Игра и готовые ISO (авторские материалы, большие файлы) ---
/source/*
/outputs/*

# --- Японский корпус и черновики (локальные, не публикуются) ---
/translation/corpus/
