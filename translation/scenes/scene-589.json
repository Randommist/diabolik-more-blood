[
  {
    "id": 101298,
    "scene": "589",
    "index": 0,
    "action": 45384,
    "group": "589:0",
    "speaker": "Юи (мысли, девушка)",
    "ja": "あの日、私はコウくんの気持ちが",
    "ru": "В тот день я решила,"
  },
  {
    "id": 101299,
    "scene": "589",
    "index": 1,
    "action": 45460,
    "group": "589:0",
    "speaker": "Юи (мысли, девушка)",
    "ja": "わかったと思った。",
    "ru": "что поняла чувства Коу-куна."
  },
  {
    "id": 101300,
    "scene": "589",
    "index": 3,
    "action": 45588,
    "group": "589:1",
    "speaker": "Юи (мысли, девушка)",
    "ja": "気持ちが通じ合ったと、",
    "ru": "Мне казалось,"
  },
  {
    "id": 101301,
    "scene": "589",
    "index": 4,
    "action": 45656,
    "group": "589:1",
    "speaker": "Юи (мысли, девушка)",
    "ja": "そう思っていた。",
    "ru": "что наши сердца созвучны."
  },
  {
    "id": 101302,
    "scene": "589",
    "index": 6,
    "action": 45784,
    "group": "589:2",
    "speaker": "Юи (мысли, девушка)",
    "ja": "けれど……それは人間である私の",
    "ru": "Но это было лишь заблуждением,"
  },
  {
    "id": 101303,
    "scene": "589",
    "index": 7,
    "action": 45860,
    "group": "589:2",
    "speaker": "Юи (мысли, девушка)",
    "ja": "勘違いに過ぎなかったのだ。",
    "ru": "свойственным мне как человеку."
  },
  {
    "id": 101304,
    "scene": "589",
    "index": 9,
    "action": 45996,
    "group": "589:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "人間に憎悪すら抱いている彼が",
    "ru": "Он питает к людям одну лишь ненависть,"
  },
  {
    "id": 101305,
    "scene": "589",
    "index": 10,
    "action": 46072,
    "group": "589:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "抱えている闇は、私が考えているほど",
    "ru": "и тьма, что таится внутри него,"
  },
  {
    "id": 101306,
    "scene": "589",
    "index": 11,
    "action": 46152,
    "group": "589:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "簡単なものではなかったのに。",
    "ru": "была куда сложнее, чем я себе представляла."
  },
  {
    "id": 101308,
    "scene": "589",
    "index": 14,
    "action": 47148,
    "group": "589:4",
    "speaker": "#Name[2]",
    "ja": "はぁっ……はぁっ……。",
    "ru": "Ха-а... ха-а..."
  },
  {
    "id": 101310,
    "scene": "589",
    "index": 16,
    "action": 47364,
    "group": "589:5",
    "speaker": "Коу",
    "ja": "ふふ、暴れないでよ。",
    "ru": "Ха-ха, не дергайся."
  },
  {
    "id": 101311,
    "scene": "589",
    "index": 17,
    "action": 47432,
    "group": "589:5",
    "speaker": "Коу",
    "ja": "大人しくしてないと、的がズレて",
    "ru": "Не будешь смирной - прицел собьется,"
  },
  {
    "id": 101312,
    "scene": "589",
    "index": 18,
    "action": 47508,
    "group": "589:5",
    "speaker": "Коу",
    "ja": "余計に痛くなるだけだよ？",
    "ru": "и будет только больнее, ясно?"
  },
  {
    "id": 101314,
    "scene": "589",
    "index": 20,
    "action": 47776,
    "group": "589:6",
    "speaker": "#Name[2]",
    "ja": "っ……ぅ……ゝ",
    "ru": "Кх... ух..."
  },
  {
    "id": 101316,
    "scene": "589",
    "index": 22,
    "action": 47984,
    "group": "589:7",
    "speaker": "Коу",
    "ja": "そんなに痛そうな顔しないでよ。",
    "ru": "Не делай такое страдальческое лицо."
  },
  {
    "id": 101317,
    "scene": "589",
    "index": 23,
    "action": 48060,
    "group": "589:7",
    "speaker": "Коу",
    "ja": "別にこのくらいじゃ死なないって。",
    "ru": "От такого ведь не умирают."
  },
  {
    "id": 101319,
    "scene": "589",
    "index": 25,
    "action": 48600,
    "group": "589:8",
    "speaker": "Коу",
    "ja": "全部おれが受けたことのある",
    "ru": "Все эти наказания"
  },
  {
    "id": 101320,
    "scene": "589",
    "index": 26,
    "action": 48672,
    "group": "589:8",
    "speaker": "Коу",
    "ja": "罰だからさ、安心でしょ？",
    "ru": "я сам когда-то терпел, так что не бойся."
  },
  {
    "id": 101321,
    "scene": "589",
    "index": 27,
    "action": 48744,
    "group": "589:8",
    "speaker": "Коу",
    "ja": "死なないって保証付きだもん。",
    "ru": "Даю гарантию - ты не умрешь."
  },
  {
    "id": 101323,
    "scene": "589",
    "index": 29,
    "action": 48892,
    "group": "589:9",
    "speaker": "#Name[2]",
    "ja": "……し、て……。",
    "ru": "...Хва... тит..."
  },
  {
    "id": 101325,
    "scene": "589",
    "index": 31,
    "action": 49292,
    "group": "589:10",
    "speaker": "Коу",
    "ja": "何ー？　聞こえないよー。",
    "ru": "Чего-о? Не слышу-у."
  },
  {
    "id": 101327,
    "scene": "589",
    "index": 33,
    "action": 49436,
    "group": "589:11",
    "speaker": "#Name[2]",
    "ja": "どう、して……こんなこと……。",
    "ru": "За... чем... ты так?.."
  },
  {
    "id": 101329,
    "scene": "589",
    "index": 35,
    "action": 49848,
    "group": "589:12",
    "speaker": "Коу",
    "ja": "どうして？　今更だなぁ。今まで",
    "ru": "Зачем? Вспомнила тоже. Мы ведь"
  },
  {
    "id": 101330,
    "scene": "589",
    "index": 36,
    "action": 49924,
    "group": "589:12",
    "speaker": "Коу",
    "ja": "だって散々やってきたことじゃない。",
    "ru": "и раньше постоянно этим занимались."
  },
  {
    "id": 101331,
    "scene": "589",
    "index": 37,
    "action": 50004,
    "group": "589:12",
    "speaker": "Коу",
    "ja": "きみ好きだったでしょ、こういうの。",
    "ru": "Тебе же вроде нравилось такое."
  },
  {
    "id": 101333,
    "scene": "589",
    "index": 39,
    "action": 50420,
    "group": "589:13",
    "speaker": "Коу",
    "ja": "あとはね、きみを喜ばせながら",
    "ru": "А еще я хочу сделать тебе приятно,"
  },
  {
    "id": 101334,
    "scene": "589",
    "index": 40,
    "action": 50496,
    "group": "589:13",
    "speaker": "Коу",
    "ja": "ちょっとたしかめようと思って。",
    "ru": "а заодно кое-что проверить."
  },
  {
    "id": 101336,
    "scene": "589",
    "index": 42,
    "action": 50908,
    "group": "589:14",
    "speaker": "Коу",
    "ja": "おれさぁ、やっぱり理解できないん",
    "ru": "Я ведь так и не могу понять"
  },
  {
    "id": 101337,
    "scene": "589",
    "index": 43,
    "action": 50988,
    "group": "589:14",
    "speaker": "Коу",
    "ja": "だよ。このわけのわかんない気持ちが。",
    "ru": "этих дурацких чувств."
  },
  {
    "id": 101339,
    "scene": "589",
    "index": 45,
    "action": 51408,
    "group": "589:15",
    "speaker": "Коу",
    "ja": "でも、きみがナイフを持って",
    "ru": "Но когда ты схватилась за нож,"
  },
  {
    "id": 101340,
    "scene": "589",
    "index": 46,
    "action": 51480,
    "group": "589:15",
    "speaker": "Коу",
    "ja": "死のうとした時……あの時だけは",
    "ru": "пытаясь покончить с собой... только тогда"
  },
  {
    "id": 101341,
    "scene": "589",
    "index": 47,
    "action": 51556,
    "group": "589:15",
    "speaker": "Коу",
    "ja": "少しだけわかりかけたんだ。",
    "ru": "до меня хоть немного дошло."
  },
  {
    "id": 101343,
    "scene": "589",
    "index": 49,
    "action": 51776,
    "group": "589:16",
    "speaker": "Коу",
    "ja": "だからね……きみがまた",
    "ru": "Поэтому... я подумал,"
  },
  {
    "id": 101344,
    "scene": "589",
    "index": 50,
    "action": 51844,
    "group": "589:16",
    "speaker": "Коу",
    "ja": "死にかければ、今度こそハッキリと",
    "ru": "что если ты снова окажешься на грани смерти,"
  },
  {
    "id": 101345,
    "scene": "589",
    "index": 51,
    "action": 51924,
    "group": "589:16",
    "speaker": "Коу",
    "ja": "分かるんじゃないかなと思って。",
    "ru": "то на этот раз я уж точно все пойму."
  },
  {
    "id": 101347,
    "scene": "589",
    "index": 53,
    "action": 52336,
    "group": "589:17",
    "speaker": "Коу",
    "ja": "でも困ったなぁ……。",
    "ru": "Но вот незадача..."
  },
  {
    "id": 101348,
    "scene": "589",
    "index": 54,
    "action": 52404,
    "group": "589:17",
    "speaker": "Коу",
    "ja": "こんなに傷つけても、まだあの時の",
    "ru": "Я причинил тебе столько боли, а того самого"
  },
  {
    "id": 101349,
    "scene": "589",
    "index": 55,
    "action": 52484,
    "group": "589:17",
    "speaker": "Коу",
    "ja": "気持ちにはならないんだよね。",
    "ru": "чувства так и не испытал."
  },
  {
    "id": 101351,
    "scene": "589",
    "index": 57,
    "action": 52896,
    "group": "589:18",
    "speaker": "Коу",
    "ja": "ただでさえイラつくのに、",
    "ru": "Меня это и так бесит,"
  },
  {
    "id": 101352,
    "scene": "589",
    "index": 58,
    "action": 52968,
    "group": "589:18",
    "speaker": "Коу",
    "ja": "困るよホント……。",
    "ru": "а тут еще и толку ноль..."
  },
  {
    "id": 101354,
    "scene": "589",
    "index": 60,
    "action": 53180,
    "group": "589:19",
    "speaker": "Коу",
    "ja": "このままじゃ、理性の糸が切れて",
    "ru": "Так у меня нить разума лопнет,"
  },
  {
    "id": 101355,
    "scene": "589",
    "index": 61,
    "action": 53256,
    "group": "589:19",
    "speaker": "Коу",
    "ja": "本当にきみのこと殺しちゃいそうだ。",
    "ru": "и я тебя реально убью."
  },
  {
    "id": 101357,
    "scene": "589",
    "index": 63,
    "action": 53772,
    "group": "589:20",
    "speaker": "#Name[2]",
    "ja": "っ……。",
    "ru": "Кх..."
  },
  {
    "id": 101359,
    "scene": "589",
    "index": 65,
    "action": 54168,
    "group": "589:21",
    "speaker": "Коу",
    "ja": "……狂ってる、か。",
    "ru": "...Я спятил, думаешь?"
  },
  {
    "id": 101360,
    "scene": "589",
    "index": 66,
    "action": 54232,
    "group": "589:21",
    "speaker": "Коу",
    "ja": "そうだね、そうかもしれないよ。",
    "ru": "Ну да, пожалуй, так и есть."
  },
  {
    "id": 101362,
    "scene": "589",
    "index": 68,
    "action": 54648,
    "group": "589:22",
    "speaker": "Коу",
    "ja": "でも思ったんだ。",
    "ru": "Но я тут подумал..."
  },
  {
    "id": 101363,
    "scene": "589",
    "index": 69,
    "action": 54712,
    "group": "589:22",
    "speaker": "Коу",
    "ja": "あのクソみたいな貴族たちも、",
    "ru": "Может, те поганые аристократы"
  },
  {
    "id": 101364,
    "scene": "589",
    "index": 70,
    "action": 54788,
    "group": "589:22",
    "speaker": "Коу",
    "ja": "おれのことを愛してたのかもってさ。",
    "ru": "тоже любили меня?"
  },
  {
    "id": 101366,
    "scene": "589",
    "index": 72,
    "action": 55208,
    "group": "589:23",
    "speaker": "Коу",
    "ja": "もしそうなら許してやらなくも",
    "ru": "Если так, то я, пожалуй,"
  },
  {
    "id": 101367,
    "scene": "589",
    "index": 73,
    "action": 55284,
    "group": "589:23",
    "speaker": "Коу",
    "ja": "ないと思うよ。だってさ……。",
    "ru": "мог бы их даже простить. Ведь..."
  },
  {
    "id": 101369,
    "scene": "589",
    "index": 75,
    "action": 55700,
    "group": "589:24",
    "speaker": "Коу",
    "ja": "なんともない奴より、愛してる奴を",
    "ru": "Убивать того, кого любишь, куда веселее,"
  },
  {
    "id": 101370,
    "scene": "589",
    "index": 76,
    "action": 55780,
    "group": "589:24",
    "speaker": "Коу",
    "ja": "殺したほうがずっと楽しそうだもん。",
    "ru": "чем того, до кого тебе нет дела."
  },
  {
    "id": 101372,
    "scene": "589",
    "index": 78,
    "action": 56456,
    "group": "589:25",
    "speaker": "#Name[2]",
    "ja": "……っ……ゝ",
    "ru": "...Кх..."
  },
  {
    "id": 101374,
    "scene": "589",
    "index": 80,
    "action": 56712,
    "group": "589:26",
    "speaker": "#Name[2]",
    "ja": "ぁ……。",
    "ru": "А..."
  },
  {
    "id": 101376,
    "scene": "589",
    "index": 82,
    "action": 57268,
    "group": "589:27",
    "speaker": "Коу",
    "ja": "あー……ん……久しぶりだね。",
    "ru": "А-а... мм... как давно это было."
  },
  {
    "id": 101377,
    "scene": "589",
    "index": 83,
    "action": 57344,
    "group": "589:27",
    "speaker": "Коу",
    "ja": "きみの血を舐めるのも。",
    "ru": "Я так соскучился по твоей крови."
  },
  {
    "id": 101379,
    "scene": "589",
    "index": 85,
    "action": 57752,
    "group": "589:28",
    "speaker": "Коу",
    "ja": "っ……へえ……心臓の血は",
    "ru": "Мх... ого... а кровь прямо из сердца"
  },
  {
    "id": 101380,
    "scene": "589",
    "index": 86,
    "action": 57824,
    "group": "589:28",
    "speaker": "Коу",
    "ja": "一段と美味いんだな……。",
    "ru": "в разы вкуснее..."
  },
  {
    "id": 101382,
    "scene": "589",
    "index": 88,
    "action": 57968,
    "group": "589:29",
    "speaker": "#Name[2]",
    "ja": "…………。",
    "ru": "......"
  },
  {
    "id": 101384,
    "scene": "589",
    "index": 90,
    "action": 58360,
    "group": "589:29",
    "speaker": "Коу",
    "ja": "あっは！　とうとう黙った！",
    "ru": "А-ха! Наконец-то замолкла!"
  },
  {
    "id": 101385,
    "scene": "589",
    "index": 91,
    "action": 58432,
    "group": "589:29",
    "speaker": "Коу",
    "ja": "お利口だよ、エム猫ちゃん。",
    "ru": "Умница, Кошечка-мазохисточка."
  },
  {
    "id": 101386,
    "scene": "589",
    "index": 92,
    "action": 58504,
    "group": "589:29",
    "speaker": "Коу",
    "ja": "ご褒美にキスでもしてあげようか？",
    "ru": "Может, поцеловать тебя в награду?"
  },
  {
    "id": 101388,
    "scene": "589",
    "index": 94,
    "action": 58656,
    "group": "589:30",
    "speaker": "#Name[2]",
    "ja": "…………。",
    "ru": "......"
  },
  {
    "id": 101390,
    "scene": "589",
    "index": 96,
    "action": 59048,
    "group": "589:30",
    "speaker": "Коу",
    "ja": "……おい、聞いてんの？",
    "ru": "...Эй, ты меня слышишь?"
  },
  {
    "id": 101392,
    "scene": "589",
    "index": 98,
    "action": 59376,
    "group": "589:31",
    "speaker": "Коу",
    "ja": "おいって、#Name[2]。",
    "ru": "Я с тобой говорю, #Name[2]."
  },
  {
    "id": 101393,
    "scene": "589",
    "index": 99,
    "action": 59444,
    "group": "589:31",
    "speaker": "Коу",
    "ja": "エム猫ちゃん？",
    "ru": "Кошечка-мазохисточка?"
  },
  {
    "id": 101395,
    "scene": "589",
    "index": 101,
    "action": 59920,
    "group": "589:32",
    "speaker": "Коу",
    "ja": "…………死んだの？",
    "ru": "......Ты что, умерла?"
  },
  {
    "id": 101397,
    "scene": "589",
    "index": 103,
    "action": 60132,
    "group": "589:33",
    "speaker": "Коу",
    "ja": "は？　嘘だろ？",
    "ru": "Чего? Да ладно?"
  },
  {
    "id": 101398,
    "scene": "589",
    "index": 104,
    "action": 60192,
    "group": "589:33",
    "speaker": "Коу",
    "ja": "いくら弱っちい人間だって、",
    "ru": "Пусть люди и слабаки,"
  },
  {
    "id": 101399,
    "scene": "589",
    "index": 105,
    "action": 60264,
    "group": "589:33",
    "speaker": "Коу",
    "ja": "このくらいじゃ死なないだろ？",
    "ru": "но от такого ведь не умирают?"
  },
  {
    "id": 101401,
    "scene": "589",
    "index": 107,
    "action": 60488,
    "group": "589:34",
    "speaker": "Коу",
    "ja": "心臓止まってるし……",
    "ru": "Сердце не бьется..."
  },
  {
    "id": 101402,
    "scene": "589",
    "index": 108,
    "action": 60556,
    "group": "589:34",
    "speaker": "Коу",
    "ja": "なんだよそれ。",
    "ru": "Да что это вообще такое?!"
  },
  {
    "id": 101404,
    "scene": "589",
    "index": 110,
    "action": 60952,
    "group": "589:35",
    "speaker": "Коу",
    "ja": "……おまえ、もう動かないの？",
    "ru": "...Ты что, больше не двигаешься?"
  },
  {
    "id": 101405,
    "scene": "589",
    "index": 111,
    "action": 61028,
    "group": "589:35",
    "speaker": "Коу",
    "ja": "なあって。",
    "ru": "Эй, ответь же."
  },
  {
    "id": 101407,
    "scene": "589",
    "index": 113,
    "action": 61532,
    "group": "589:36",
    "speaker": "Коу",
    "ja": "…………。",
    "ru": "......"
  },
  {
    "id": 101409,
    "scene": "589",
    "index": 115,
    "action": 62100,
    "group": "589:36",
