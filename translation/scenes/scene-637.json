    "group": "637:85",
    "speaker": "Райнхард",
    "ja": "ふふふ、若いっていいねぇ。",
    "ru": "Ха-ха-ха, как прекрасна молодость."
  },
  {
    "id": 112652,
    "scene": "637",
    "index": 240,
    "action": 86484,
    "group": "637:86",
    "speaker": "Руки",
    "ja": "……良いのですか？",
    "ru": "...Вы уверены, что так можно?"
  },
  {
    "id": 112654,
    "scene": "637",
    "index": 242,
    "action": 86704,
    "group": "637:87",
    "speaker": "Райнхард",
    "ja": "ふたりが愛し合っていれば、",
    "ru": "Если они любят друг друга,"
  },
  {
    "id": 112655,
    "scene": "637",
    "index": 243,
    "action": 86776,
    "group": "637:87",
    "speaker": "Райнхард",
    "ja": "何も問題はないよ。ルキくん。",
    "ru": "в этом нет ничего дурного, Руки-кун."
  },
  {
    "id": 112657,
    "scene": "637",
    "index": 245,
    "action": 87000,
    "group": "637:88",
    "speaker": "Руки",
    "ja": "…………。",
    "ru": "..."
  },
  {
    "id": 112659,
    "scene": "637",
    "index": 247,
    "action": 87212,
    "group": "637:88",
    "speaker": "Райнхард",
    "ja": "この世に、想い合う愛ほど",
    "ru": "В этом мире нет ничего прекраснее,"
  },
  {
    "id": 112660,
    "scene": "637",
    "index": 248,
    "action": 87284,
    "group": "637:88",
    "speaker": "Райнхард",
    "ja": "美しいものはない。",
    "ru": "чем взаимная любовь."
  },
  {
    "id": 112662,
    "scene": "637",
    "index": 250,
    "action": 87992,
    "group": "637:89",
    "speaker": "#Name[2]",
    "ja": "まさかヴァンパイアのお嫁さんに",
    "ru": "Никогда бы не подумала,"
  },
  {
    "id": 112663,
    "scene": "637",
    "index": 251,
    "action": 88068,
    "group": "637:89",
    "speaker": "#Name[2]",
    "ja": "なるとは思わなかった。",
    "ru": "что стану невестой вампира."
  },
  {
    "id": 112665,
    "scene": "637",
    "index": 253,
    "action": 88284,
    "group": "637:90",
    "speaker": "Юма",
    "ja": "これで完全にシスターへの道は",
    "ru": "Теперь путь в монахини для тебя окончательно"
  },
  {
    "id": 112666,
    "scene": "637",
    "index": 254,
    "action": 88360,
    "group": "637:90",
    "speaker": "Юма",
    "ja": "閉ざされたな。いい気味だ。",
    "ru": "закрыт. Так тебе и надо."
  },
  {
    "id": 112668,
    "scene": "637",
    "index": 256,
    "action": 88504,
    "group": "637:91",
    "speaker": "#Name[2]",
    "ja": "ふふっ、別にいいよ。",
    "ru": "Хи-хи, ну и пусть."
  },
  {
    "id": 112669,
    "scene": "637",
    "index": 257,
    "action": 88572,
    "group": "637:91",
    "speaker": "#Name[2]",
    "ja": "お嫁さんも夢のひとつだったもの。",
    "ru": "Стать невестой тоже было моей мечтой."
  },
  {
    "id": 112671,
    "scene": "637",
    "index": 259,
    "action": 88800,
    "group": "637:92",
    "speaker": "Юма",
    "ja": "シスターと真逆じゃねえか！",
    "ru": "Это же полная противоположность монахине!"
  },
  {
    "id": 112672,
    "scene": "637",
    "index": 260,
    "action": 88872,
    "group": "637:92",
    "speaker": "Юма",
    "ja": "これだから女ってやつは……。",
    "ru": "Вот уж эти бабы..."
  },
  {
    "id": 112673,
    "scene": "637",
    "index": 261,
    "action": 88948,
    "group": "637:92",
    "speaker": "Юма",
    "ja": "移ろいやすいったらねえ。",
    "ru": "Ветреные донельзя."
  },
  {
    "id": 112675,
    "scene": "637",
    "index": 263,
    "action": 89532,
    "group": "637:93",
    "speaker": "Юма",
    "ja": "おいコラ。オマエ、",
    "ru": "Эй, слышишь. Ты мне смотри,"
  },
  {
    "id": 112676,
    "scene": "637",
    "index": 264,
    "action": 89596,
    "group": "637:93",
    "speaker": "Юма",
    "ja": "この先あっさり心変わり",
    "ru": "если потом так же легко"
  },
  {
    "id": 112677,
    "scene": "637",
    "index": 265,
    "action": 89664,
    "group": "637:93",
    "speaker": "Юма",
    "ja": "しやがったら許さねえぞ。",
    "ru": "передумаешь - я тебе не спущу."
  },
  {
    "id": 112679,
    "scene": "637",
    "index": 267,
    "action": 89808,
    "group": "637:94",
    "speaker": "#Name[2]",
    "ja": "それはこっちの台詞だよ。",
    "ru": "Это я тебе должна сказать."
  },
  {
    "id": 112680,
    "scene": "637",
    "index": 268,
    "action": 89880,
    "group": "637:94",
    "speaker": "#Name[2]",
    "ja": "ユーマくん、飽きやすいんだから。",
    "ru": "Ты ведь, Юма-кун, быстро ко всему остываешь."
  },
  {
    "id": 112681,
    "scene": "637",
    "index": 269,
    "action": 89960,
    "group": "637:94",
    "speaker": "#Name[2]",
    "ja": "この間だって――",
    "ru": "Вот даже на днях..."
  },
  {
    "id": 112683,
    "scene": "637",
    "index": 271,
    "action": 90172,
    "group": "637:95",
    "speaker": "Юма",
    "ja": "チッ、うるせえなぁ。",
    "ru": "Тц, да замолчи ты."
  },
  {
    "id": 112684,
    "scene": "637",
    "index": 272,
    "action": 90240,
    "group": "637:95",
    "speaker": "Юма",
    "ja": "いいぜ。じゃあ誓ってやるよ。",
    "ru": "Ладно. Тогда я принесу клятву."
  },
  {
    "id": 112686,
    "scene": "637",
    "index": 274,
    "action": 90464,
    "group": "637:96",
    "speaker": "Юма",
    "ja": "……と、その前に。",
    "ru": "...Но сперва кое-что ещё."
  },
  {
    "id": 112687,
    "scene": "637",
    "index": 275,
    "action": 90528,
    "group": "637:96",
    "speaker": "Юма",
    "ja": "おい、制服じゃ味気ねぇ。",
    "ru": "В одной форме как-то уныло."
  },
  {
    "id": 112688,
    "scene": "637",
    "index": 276,
    "action": 90600,
    "group": "637:96",
    "speaker": "Юма",
    "ja": "これつけろ。",
    "ru": "Приколи вот это."
  },
  {
    "id": 112690,
    "scene": "637",
    "index": 278,
    "action": 90848,
    "group": "637:97",
    "speaker": "#Name[2]",
    "ja": "これ……さっきの薔薇。",
    "ru": "Это же... та самая роза."
  },
  {
    "id": 112692,
    "scene": "637",
    "index": 280,
    "action": 91064,
    "group": "637:98",
    "speaker": "Юма",
    "ja": "ああ……。",
    "ru": "Ага..."
  },
  {
    "id": 112693,
    "scene": "637",
    "index": 281,
    "action": 91120,
    "group": "637:98",
    "speaker": "Юма",
    "ja": "きっと、ボスも見てくれてる。",
    "ru": "Босс тоже наверняка видит нас."
  },
  {
    "id": 112694,
    "scene": "637",
    "index": 282,
    "action": 91196,
    "group": "637:98",
    "speaker": "Юма",
    "ja": "ボスも……喜んでくれてるはずだ。",
    "ru": "Он... точно порадовался бы."
  },
  {
    "id": 112696,
    "scene": "637",
    "index": 284,
    "action": 91348,
    "group": "637:99",
    "speaker": "#Name[2]",
    "ja": "うん……！　そうだよ、絶対。",
    "ru": "Да!.. Непременно."
  },
  {
    "id": 112698,
    "scene": "637",
    "index": 286,
    "action": 91496,
    "group": "637:100",
    "speaker": "#Name[2]",
    "ja": "嬉しい、ありがとう……。",
    "ru": "Я так рада, спасибо..."
  },
  {
    "id": 112700,
    "scene": "637",
    "index": 288,
    "action": 91716,
    "group": "637:101",
    "speaker": "Юма",
    "ja": "……おうよ……。",
    "ru": "...Да ладно тебе..."
  },
  {
    "id": 112702,
    "scene": "637",
    "index": 290,
    "action": 91928,
    "group": "637:102",
    "speaker": "Юма",
    "ja": "……よし。",
    "ru": "...Ну всё."
  },
  {
    "id": 112704,
    "scene": "637",
    "index": 292,
    "action": 92056,
    "group": "637:103",
    "speaker": "#Name[2]",
    "ja": "ユーマくん……。",
    "ru": "Юма-кун..."
  },
  {
    "id": 112706,
    "scene": "637",
    "index": 294,
    "action": 92268,
    "group": "637:104",
    "speaker": "Юма",
    "ja": "無神ユーマは#Name[1]#Name[2]",
    "ru": "Юма Муками клянётся: #Name[1]#Name[2] -"
  },
  {
    "id": 112707,
    "scene": "637",
    "index": 295,
    "action": 92344,
    "group": "637:104",
    "speaker": "Юма",
    "ja": "以外の血は一生吸わないことをここに",
    "ru": "единственная, чью кровь он будет пить"
  },
  {
    "id": 112708,
    "scene": "637",
    "index": 296,
    "action": 92424,
    "group": "637:104",
    "speaker": "Юма",
    "ja": "誓います。オラ、これでいいか？",
    "ru": "до конца жизни. Вот. Так пойдёт?"
  },
  {
    "id": 112710,
    "scene": "637",
    "index": 298,
    "action": 92572,
    "group": "637:105",
    "speaker": "#Name[2]",
    "ja": "……全然、愛を感じないよ？",
    "ru": "...В твоих словах совсем не чувствуется любви."
  },
  {
    "id": 112712,
    "scene": "637",
    "index": 300,
    "action": 92792,
    "group": "637:106",
    "speaker": "Юма",
    "ja": "んだと、コラ。ヴァンパイアが",
    "ru": "Чего вякнула? Тебе это вампир говорит,"
  },
  {
    "id": 112713,
    "scene": "637",
    "index": 301,
    "action": 92868,
    "group": "637:106",
    "speaker": "Юма",
    "ja": "言ってんだぞ。愛の塊だろうが。",
    "ru": "между прочим! Это и есть чистая любовь!"
  },
  {
    "id": 112715,
    "scene": "637",
    "index": 303,
    "action": 93016,
    "group": "637:107",
    "speaker": "#Name[2]",
    "ja": "だって好きじゃなくても血は",
    "ru": "Но кровь ведь можно пить"
  },
  {
    "id": 112716,
    "scene": "637",
    "index": 304,
    "action": 93088,
    "group": "637:107",
    "speaker": "#Name[2]",
    "ja": "吸うでしょ？　私の血は特別",
    "ru": "и без чувств, правда? К тому же моя,"
  },
  {
    "id": 112717,
    "scene": "637",
    "index": 305,
    "action": 93160,
    "group": "637:107",
    "speaker": "#Name[2]",
    "ja": "おいしいらしいし。",
    "ru": "говорят, особенно вкусная."
  },
  {
    "id": 112719,
    "scene": "637",
    "index": 307,
    "action": 93372,
    "group": "637:108",
    "speaker": "Юма",
    "ja": "……チッ、わかったよ。",
    "ru": "...Тц, ладно, понял я."
  },
  {
    "id": 112720,
    "scene": "637",
    "index": 308,
    "action": 93440,
    "group": "637:108",
    "speaker": "Юма",
    "ja": "オラ、耳貸せ。",
    "ru": "А ну, придвинься поближе."
  },
  {
    "id": 112722,
    "scene": "637",
    "index": 310,
    "action": 93648,
    "group": "637:109",
    "speaker": "Юма",
    "ja": "無神ユーマはオマエだけを",
    "ru": "Муками Юма клянется любить вечно"
  },
  {
    "id": 112723,
    "scene": "637",
    "index": 311,
    "action": 93720,
    "group": "637:109",
    "speaker": "Юма",
    "ja": "永遠に愛すると誓ってやる。",
    "ru": "только тебя одну."
  },
  {
    "id": 112724,
    "scene": "637",
    "index": 312,
    "action": 93792,
    "group": "637:109",
    "speaker": "Юма",
    "ja": "……これで満足か？",
    "ru": "...Теперь довольна?"
  },
  {
    "id": 112726,
    "scene": "637",
    "index": 314,
    "action": 93928,
    "group": "637:110",
    "speaker": "#Name[2]",
    "ja": "ふふ、良しとしましょう。",
    "ru": "Хи-хи, так уж и быть, принимается."
  },
  {
    "id": 112728,
    "scene": "637",
    "index": 316,
    "action": 94148,
    "group": "637:111",
    "speaker": "Юма",
    "ja": "ふっ……ホント、面倒くせえ女。",
    "ru": "Фф... Ну и морока с тобой."
  },
  {
    "id": 112730,
    "scene": "637",
    "index": 318,
    "action": 94736,
    "group": "637:112",
    "speaker": "Юма",
    "ja": "……これでオマエは、正真正銘",
    "ru": "...Теперь ты целиком и полностью"
  },
  {
    "id": 112731,
    "scene": "637",
    "index": 319,
    "action": 94812,
    "group": "637:112",
    "speaker": "Юма",
    "ja": "オレのモンだ、#Name[2]。",
    "ru": "принадлежишь мне, #Name[2]."
  },
  {
    "id": 112733,
    "scene": "637",
    "index": 321,
    "action": 95032,
    "group": "637:113",
    "speaker": "Юма",
    "ja": "さっきの誓い通り、一生",
    "ru": "Как и обещал в клятве, всю жизнь"
  },
  {
    "id": 112734,
    "scene": "637",
    "index": 322,
    "action": 95100,
    "group": "637:113",
    "speaker": "Юма",
    "ja": "オマエだけを愛してやるよ。",
    "ru": "буду любить только тебя."
  },
  {
    "id": 112736,
    "scene": "637",
    "index": 324,
    "action": 95244,
    "group": "637:114",
    "speaker": "#Name[2]",
    "ja": "うん、私もユーマくんのことが",
    "ru": "Угу, а я буду всем сердцем"
  },
  {
    "id": 112737,
    "scene": "637",
    "index": 325,
    "action": 95320,
    "group": "637:114",
    "speaker": "#Name[2]",
    "ja": "死ぬまで大好きだよ。",
    "ru": "любить тебя, Юма-кун, до самой смерти."
  },
  {
    "id": 112739,
    "scene": "637",
    "index": 327,
    "action": 95536,
    "group": "637:115",
    "speaker": "Юма",
    "ja": "バァカ。そこは死んでも、だ。",
    "ru": "Дурочка. Надо говорить: \"даже после смерти\"."
  },
  {
    "id": 112741,
    "scene": "637",
    "index": 329,
    "action": 95760,
    "group": "637:116",
    "speaker": "Юма",
    "ja": "……オレだけのイブ。",
    "ru": "...Моя единственная Ева."
  },
  {
    "id": 112742,
    "scene": "637",
    "index": 330,
    "action": 95828,
    "group": "637:116",
    "speaker": "Юма",
    "ja": "もう離さないぜ。",
    "ru": "Больше я тебя не отпущу."
  }
]
