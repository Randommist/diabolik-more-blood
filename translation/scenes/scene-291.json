  {
    "id": 25998,
    "scene": "291",
    "index": 167,
    "action": 69032,
    "speaker": "#Name[2]",
    "group": "291:57",
    "ja": "ええっゞ　それがどうして",
    "ru": "Что?! Зачем же сразу"
