    "id": 26048,
    "scene": "291",
    "index": 217,
    "action": 74812,
    "group": "291:72",
    "speaker": "Канато",
    "ja": "いいよ、キスしてあげる。",
    "ru": "Хорошо, поцелую."
  },
  {
    "id": 26050,
    "scene": "291",
