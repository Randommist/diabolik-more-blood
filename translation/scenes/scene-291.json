    "id": 25972,
    "scene": "291",
    "index": 141,
    "action": 64652,
    "group": "291:47",
    "speaker": "#Name[2]",
    "ja": "だ、だって……。",
    "ru": "Н-ну…"
  },
  {
    "id": 25974,
    "scene": "291",
    "index": 143,
    "action": 65056,
    "group": "291:48",
    "speaker": "Канато",
    "ja": "そういうところもかわいいって、",
    "ru": "Я говорю, что мне это тоже нравится."
  },
  {
    "id": 25975,
    "scene": "291",
    "index": 144,
    "action": 65132,
    "group": "291:48",
    "speaker": "Канато",
    "ja": "言ってるんだから喜んでください。",
    "ru": "Так радуйся."
  },
  {
    "id": 25977,
    "scene": "291",
    "index": 146,
    "action": 65284,
    "group": "291:49",
    "speaker": "#Name[2]",
    "ja": "本当に？",
    "ru": "Правда?"
  },
  {
    "id": 25979,
    "scene": "291",
    "index": 148,
    "action": 65676,
    "group": "291:50",
    "speaker": "Канато",
    "ja": "疑うんですか？",
    "ru": "Сомневаешься?"
  },
  {
    "id": 25980,
    "scene": "291",
    "index": 149,
    "action": 65736,
    "group": "291:50",
    "speaker": "Канато",
    "ja": "だったら、行動で示してあげます。",
    "ru": "Тогда докажу делом."
  },
  {
    "id": 25982,
    "scene": "291",
    "index": 151,
    "action": 66728,
    "group": "291:51",
    "speaker": "#Name[2]",
    "ja": "わっ……ゞ",
    "ru": "Ой…!"
  },
  {
    "id": 25984,
    "scene": "291",
    "index": 153,
    "action": 66856,
    "speaker": "#Name[2]",
    "group": "291:52",
    "ja": "か、カナトくん……こんなところで",
    "ru": "К-Канато-кун… повалить меня"
