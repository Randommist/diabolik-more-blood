    "index": 120,
    "action": 61716,
    "group": "291:40",
    "speaker": "#Name[2]",
    "ja": "森を散策するのもいいかな。",
    "ru": "держась за руки?"
  },
  {
    "id": 25953,
    "scene": "291",
    "index": 122,
    "action": 62124,
    "group": "291:41",
    "speaker": "Канато",
    "ja": "すっかりはしゃいじゃって……",
    "ru": "Расшалилась совсем…"
  },
  {
    "id": 25954,
    "scene": "291",
    "index": 123,
    "action": 62200,
    "group": "291:41",
    "speaker": "Канато",
    "ja": "まるで子供みたいです。",
    "ru": "Как ребёнок."
  },
  {
    "id": 25956,
    "scene": "291",
    "index": 125,
    "action": 62464,
    "group": "291:42",
    "speaker": "#Name[2]",
    "ja": "あ、ごめんなさい……。",
    "ru": "А… прости."
  },
  {
    "id": 25957,
    "scene": "291",
    "index": 126,
    "action": 62532,
    "group": "291:42",
    "speaker": "#Name[2]",
    "ja": "私ひとりだけ……。",
    "ru": "Только я одна…"
  },
  {
    "id": 25959,
    "scene": "291",
    "index": 128,
    "action": 62936,
    "group": "291:43",
    "speaker": "Канато",
    "ja": "謝らなくてもいいですよ。",
    "ru": "Извиняться не нужно."
  },
  {
    "id": 25960,
    "scene": "291",
    "index": 129,
    "action": 63008,
    "group": "291:43",
    "speaker": "Канато",
    "ja": "君は楽しそうですし、連れてきた",
    "ru": "Ты радуешься, так что привести тебя сюда"
  },
  {
    "id": 25961,
    "scene": "291",
    "index": 130,
    "action": 63084,
    "group": "291:43",
    "speaker": "Канато",
    "ja": "甲斐は充分にありました。",
    "ru": "было не зря."
  },
