  {
    "id": 25989,
    "scene": "291",
    "index": 158,
    "action": 67496,
    "speaker": "Канато",
    "group": "291:53",
    "ja": "なんですから。",
    "ru": "совсем одни."
  },
  {
    "id": 25991,
    "scene": "291",
    "index": 160,
    "action": 67704,
    "speaker": "Канато",
    "group": "291:54",
    "ja": "ね？",
    "ru": "Правда?"
  },
  {
    "id": 25993,
    "scene": "291",
    "index": 162,
    "action": 68316,
    "speaker": "#Name[2]",
    "group": "291:55",
    "ja": "う、うん……そうだけど……。",
    "ru": "Н-ну да… это так, но…"
