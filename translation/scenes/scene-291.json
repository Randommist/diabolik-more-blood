  {
    "id": 25965,
    "scene": "291",
    "index": 134,
    "action": 63644,
    "group": "291:44",
    "speaker": "Канато",
    "ja": "よかったとも思う。",
    "ru": "раньше."
  },
  {
    "id": 25967,
    "scene": "291",
    "index": 136,
    "action": 63904,
    "group": "291:45",
    "speaker": "#Name[2]",
    "ja": "カナトくん……。",
    "ru": "Канато-кун…"
