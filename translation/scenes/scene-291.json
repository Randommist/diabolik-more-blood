  {
    "id": 25987,
    "scene": "291",
    "index": 156,
    "action": 67348,
    "speaker": "Канато",
    "group": "291:53",
    "ja": "どうせ誰も見ていないよ。",
    "ru": "Всё равно ведь никто не видит."
