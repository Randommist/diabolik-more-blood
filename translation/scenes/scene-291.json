  {
    "id": 25969,
    "scene": "291",
    "index": 138,
    "action": 64304,
    "group": "291:46",
    "speaker": "Канато",
    "ja": "いかにも感動しましたって顔して、",
    "ru": "С таким растроганным лицом…"
