  {
    "id": 25999,
    "scene": "291",
    "index": 168,
    "action": 69104,
    "speaker": "#Name[2]",
    "group": "291:57",
    "ja": "私の服を破ることになるのゞ",
    "ru": "рвать на мне платье?!"
