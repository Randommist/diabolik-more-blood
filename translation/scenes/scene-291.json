    "action": 75192,
    "group": "291:73",
    "speaker": "#Name[2]",
    "ja": "ん……。",
    "ru": "Н-нн…"
  },
  {
    "id": 26052,
    "scene": "291",
    "index": 221,
    "action": 75760,
    "group": "291:74",
    "speaker": "Канато",
    "ja": "#Name[2]さん、愛してます。",
    "ru": "#Name[2]-сан, я люблю тебя."
