[
  {
    "id": 81279,
    "scene": "513",
    "index": 0,
    "action": 45368,
    "group": "513:0",
    "speaker": "Юи (мысли, девушка)",
    "ja": "主を失った屋敷が朽ちていくのは、",
    "ru": "Особняк без хозяина пришел в упадок",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81280,
    "scene": "513",
    "index": 1,
    "action": 45448,
    "group": "513:0",
    "speaker": "Юи (мысли, девушка)",
    "ja": "あっという間だった。",
    "ru": "поразительно быстро.",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81281,
    "scene": "513",
    "index": 3,
    "action": 45580,
    "group": "513:1",
    "speaker": "Юи (мысли, девушка)",
    "ja": "父が死に、母が消えてから数週間。",
    "ru": "Прошло несколько недель после смерти отца",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81282,
    "scene": "513",
    "index": 4,
    "action": 45660,
    "group": "513:1",
    "speaker": "Юи (мысли, девушка)",
    "ja": "行く宛てもなく、しばらくは",
    "ru": "и исчезновения матери. Мне некуда было идти,",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81283,
    "scene": "513",
    "index": 5,
    "action": 45732,
    "group": "513:1",
    "speaker": "Юи (мысли, девушка)",
    "ja": "静まり返った屋敷に留まっていたが、",
    "ru": "и какое-то время я оставался",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81284,
    "scene": "513",
    "index": 6,
    "action": 45812,
    "group": "513:1",
    "speaker": "Юи (мысли, девушка)",
    "ja": "それもそろそろ限界だ。",
    "ru": "в опустевшем особняке, но всему есть предел.",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81285,
    "scene": "513",
    "index": 8,
    "action": 45944,
    "group": "513:2",
    "speaker": "Юи (мысли, девушка)",
    "ja": "略奪の末に残ったのは、売っても",
    "ru": "После грабежей остались лишь мелочи,",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81286,
    "scene": "513",
    "index": 9,
    "action": 46020,
    "group": "513:2",
    "speaker": "Юи (мысли, девушка)",
    "ja": "せいぜい三日暮らせるかどうかの",
    "ru": "за которые можно было выручить",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81287,
    "scene": "513",
    "index": 10,
    "action": 46096,
    "group": "513:2",
    "speaker": "Юи (мысли, девушка)",
    "ja": "小物ばかり。",
    "ru": "от силы на три дня жизни.",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81288,
    "scene": "513",
    "index": 12,
    "action": 46220,
    "group": "513:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "もしかしたら母が帰ってくるのではと",
    "ru": "Бывали дни, когда я надеялся,",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81289,
    "scene": "513",
    "index": 13,
    "action": 46300,
    "group": "513:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "希望を抱いた日もあったが、",
    "ru": "что мать, возможно, вернется,",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81290,
    "scene": "513",
    "index": 14,
    "action": 46372,
    "group": "513:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "そんな思いはとうに消えた。",
    "ru": "но эта надежда давно исчезла.",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81291,
    "scene": "513",
    "index": 16,
    "action": 46508,
    "group": "513:4",
    "speaker": "Юи (мысли, девушка)",
    "ja": "人けのなくなった屋敷を訪れるのは",
    "ru": "Теперь в опустевший особняк приходили",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81292,
    "scene": "513",
    "index": 17,
    "action": 46588,
    "group": "513:4",
    "speaker": "Юи (мысли, девушка)",
    "ja": "金目当てに侵入してくる賊くらいな",
    "ru": "разве что воры, искавшие",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81293,
    "scene": "513",
    "index": 18,
    "action": 46668,
    "group": "513:4",
    "speaker": "Юи (мысли, девушка)",
    "ja": "ものだった。",
    "ru": "чем поживиться.",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81294,
    "scene": "513",
    "index": 20,
    "action": 46792,
    "group": "513:5",
    "speaker": "Юи (мысли, девушка)",
    "ja": "俺はその度に息を潜め、奴らが諦めて",
    "ru": "Каждый раз я затаивался и ждал,",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81295,
    "scene": "513",
    "index": 21,
    "action": 46872,
    "group": "513:5",
    "speaker": "Юи (мысли, девушка)",
    "ja": "帰る時をじっと待つ。",
    "ru": "пока они сдадутся и уйдут.",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81296,
    "scene": "513",
    "index": 23,
    "action": 47004,
    "group": "513:6",
    "speaker": "Юи (мысли, девушка)",
    "ja": "そうして荒らされていくうちに、",
    "ru": "Постепенно дом разграбили так,",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81297,
    "scene": "513",
    "index": 24,
    "action": 47080,
    "group": "513:6",
    "speaker": "Юи (мысли, девушка)",
    "ja": "やがて屋敷は人の暮らせる環境では",
    "ru": "что жить в нем",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81298,
    "scene": "513",
    "index": 25,
    "action": 47160,
    "group": "513:6",
    "speaker": "Юи (мысли, девушка)",
    "ja": "なくなった。",
    "ru": "стало невозможно.",
    "context_note": "Source speaker label is Yui-thought, but context is Ruki male POV/backstory."
  },
  {
    "id": 81299,
    "scene": "513",
    "index": 27,
    "action": 47284,
    "group": "513:7",
    "speaker": "Юи (мысли, девушка)",
    "ja": "決断しなければならない。",
