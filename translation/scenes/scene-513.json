    "speaker": "Руки",
    "ja": "人らしい心など残っていない。",
    "ru": "и ничего человеческого во мне не осталось."
  },
  {
    "id": 81367,
    "scene": "513",
    "index": 100,
    "action": 59248,
    "group": "513:31",
    "speaker": "Руки",
    "ja": "元が人間ならば優しくしてもらえる",
    "ru": "Если думаешь, что я буду добрее"
  },
  {
    "id": 81368,
    "scene": "513",
    "index": 101,
    "action": 59328,
    "group": "513:31",
    "speaker": "Руки",
    "ja": "かもしれないなどという甘い考えは",
    "ru": "лишь потому, что раньше был человеком,"
  },
  {
    "id": 81369,
    "scene": "513",
    "index": 102,
    "action": 59408,
    "group": "513:31",
    "speaker": "Руки",
    "ja": "今すぐ捨て去るんだな。",
    "ru": "выбрось эту глупость из головы."
  },
  {
    "id": 81371,
    "scene": "513",
    "index": 104,
    "action": 59816,
    "group": "513:32",
    "speaker": "Руки",
    "ja": "俺は……お前たち人間を",
    "ru": "Я... ненавижу вас,"
  },
  {
    "id": 81372,
    "scene": "513",
    "index": 105,
    "action": 59884,
    "group": "513:32",
    "speaker": "Руки",
    "ja": "恨んでいるんだ。",
    "ru": "людей."
  },
  {
    "id": 81374,
    "scene": "513",
    "index": 107,
    "action": 60096,
    "group": "513:33",
    "speaker": "Руки",
    "ja": "特に……愛されることを",
    "ru": "Особенно тех, кто считает,"
  },
  {
    "id": 81375,
    "scene": "513",
    "index": 108,
    "action": 60164,
    "group": "513:33",
    "speaker": "Руки",
    "ja": "当然の権利のように思っている奴。",
    "ru": "что быть любимым - их естественное право."
  },
  {
    "id": 81377,
    "scene": "513",
    "index": 110,
    "action": 60392,
    "group": "513:34",
    "speaker": "Руки",
    "ja": "他人から愛されることばかりに",
    "ru": "Больше всего меня злят глупцы,"
  },
  {
    "id": 81378,
    "scene": "513",
    "index": 111,
    "action": 60468,
    "group": "513:34",
    "speaker": "Руки",
    "ja": "腐心している愚か者が一番腹立たしい",
    "ru": "которые думают только о том,"
  },
  {
    "id": 81379,
    "scene": "513",
    "index": 112,
    "action": 60548,
    "group": "513:34",
    "speaker": "Руки",
    "ja": "んだ。……お前のような、な。",
    "ru": "как добиться чужой любви. Такие, как ты."
  },
  {
    "id": 81381,
    "scene": "513",
    "index": 114,
    "action": 60820,
    "group": "513:35",
    "speaker": "#Name[2]",
    "ja": "私は、そんな……。",
    "ru": "Я не такая..."
  },
  {
    "id": 81383,
    "scene": "513",
    "index": 116,
    "action": 61220,
    "group": "513:36",
    "speaker": "Руки",
    "ja": "違うと言うのか？　では、自分は",
    "ru": "Хочешь сказать, что нет?"
  },
  {
    "id": 81384,
    "scene": "513",
    "index": 117,
    "action": 61296,
    "group": "513:36",
    "speaker": "Руки",
    "ja": "父親に愛されていると言い切ったのは",
    "ru": "Тогда кто уверял, что отец"
  },
  {
    "id": 81385,
    "scene": "513",
    "index": 118,
    "action": 61376,
    "group": "513:36",
    "speaker": "Руки",
    "ja": "どの口だ。この口じゃないのか？",
    "ru": "его любит? Не этими ли губами?"
  },
  {
    "id": 81387,
    "scene": "513",
    "index": 120,
    "action": 61760,
    "group": "513:37",
    "speaker": "#Name[2]",
    "ja": "っ……痛……。",
    "ru": "Ах... больно..."
  },
  {
    "id": 81389,
    "scene": "513",
    "index": 122,
    "action": 61968,
    "group": "513:38",
    "speaker": "Руки",
    "ja": "……腹が立つ。",
    "ru": "...Раздражает."
  },
  {
    "id": 81390,
    "scene": "513",
    "index": 123,
    "action": 62028,
    "group": "513:38",
    "speaker": "Руки",
    "ja": "お前を見ているのも、逆巻の奴らを",
    "ru": "И смотреть на тебя, и смотреть"
  },
  {
    "id": 81391,
    "scene": "513",
    "index": 124,
    "action": 62108,
    "group": "513:38",
    "speaker": "Руки",
    "ja": "見ているのも。",
    "ru": "на этих Сакамаки."
  },
  {
    "id": 81393,
    "scene": "513",
    "index": 126,
    "action": 62316,
    "group": "513:39",
    "speaker": "Руки",
    "ja": "当然のように愛を強請る。",
    "ru": "Вы выпрашиваете любовь как должное."
  },
  {
    "id": 81394,
    "scene": "513",
    "index": 127,
    "action": 62388,
    "group": "513:39",
    "speaker": "Руки",
    "ja": "その性根が気に食わない。",
    "ru": "Мне противна сама эта натура."
  },
  {
    "id": 81396,
    "scene": "513",
    "index": 129,
    "action": 62656,
    "group": "513:40",
    "speaker": "#Name[2]",
    "ja": "……愛されたいと思うことは",
    "ru": "...Разве плохо хотеть,"
  },
  {
    "id": 81397,
    "scene": "513",
    "index": 130,
    "action": 62728,
    "group": "513:40",
    "speaker": "#Name[2]",
    "ja": "いけないことなの？",
    "ru": "чтобы тебя любили?"
  },
  {
    "id": 81399,
    "scene": "513",
    "index": 132,
    "action": 63132,
    "group": "513:41",
    "speaker": "Руки",
    "ja": "いけなくはないさ。",
    "ru": "Нет, не плохо."
  },
  {
    "id": 81400,
    "scene": "513",
    "index": 133,
    "action": 63196,
    "group": "513:41",
    "speaker": "Руки",
    "ja": "だが……そいつに、それだけの",
    "ru": "Но... вопрос в том,"
  },
  {
    "id": 81401,
    "scene": "513",
    "index": 134,
    "action": 63272,
    "group": "513:41",
    "speaker": "Руки",
    "ja": "価値があるかが問題なんだ。",
    "ru": "заслуживает ли человек такой любви."
  },
  {
    "id": 81403,
    "scene": "513",
    "index": 136,
    "action": 63492,
    "group": "513:42",
    "speaker": "Руки",
    "ja": "そして、#Name[2]。",
    "ru": "А ты, #Name[2],"
  },
  {
    "id": 81404,
    "scene": "513",
    "index": 137,
    "action": 63556,
    "group": "513:42",
    "speaker": "Руки",
    "ja": "お前にはその価値がない。",
    "ru": "ее не заслуживаешь."
  },
  {
    "id": 81406,
    "scene": "513",
    "index": 139,
    "action": 63824,
    "group": "513:43",
    "speaker": "#Name[2]",
    "ja": "…………。",
    "ru": "............"
  },
  {
    "id": 81408,
    "scene": "513",
    "index": 141,
    "action": 64028,
    "group": "513:43",
    "speaker": "Руки",
    "ja": "少なくとも俺にとってはな。",
    "ru": "По крайней мере, для меня."
  },
  {
    "id": 81409,
    "scene": "513",
    "index": 142,
    "action": 64100,
    "group": "513:43",
    "speaker": "Руки",
    "ja": "俺にとってのお前の価値は――",
    "ru": "Для меня твоя ценность..."
  },
  {
    "id": 81411,
    "scene": "513",
    "index": 144,
    "action": 64484,
    "group": "513:44",
    "speaker": "#Name[2]",
    "ja": "あっ……！",
    "ru": "Ах!.."
  },
  {
    "id": 81413,
    "scene": "513",
    "index": 146,
    "action": 64688,
    "group": "513:45",
    "speaker": "Руки",
    "ja": "っ……ん……。",
    "ru": "...Мм..."
  },
  {
    "id": 81415,
    "scene": "513",
    "index": 148,
    "action": 65020,
    "group": "513:46",
    "speaker": "Руки",
    "ja": "……はっ……。",
    "ru": "...Ха..."
  },
  {
    "id": 81416,
    "scene": "513",
    "index": 149,
    "action": 65080,
    "group": "513:46",
    "speaker": "Руки",
    "ja": "――この血くらいなものだ。",
    "ru": "...лишь в этой крови."
  },
  {
    "id": 81418,
    "scene": "513",
    "index": 151,
    "action": 65348,
    "group": "513:47",
    "speaker": "#Name[2]",
    "ja": "（そんな、言い方……ひどい……）",
    "ru": "(Как... жестоко так говорить...)"
  },
  {
    "id": 81420,
    "scene": "513",
    "index": 153,
    "action": 65768,
    "group": "513:48",
    "speaker": "Руки",
    "ja": "ふ……なんだ。",
    "ru": "Хм... что такое?"
  },
  {
    "id": 81421,
    "scene": "513",
    "index": 154,
    "action": 65828,
    "group": "513:48",
    "speaker": "Руки",
    "ja": "不満とでも言いたげな顔だな？",
    "ru": "По лицу видно, что ты недовольна."
  },
  {
    "id": 81423,
    "scene": "513",
    "index": 156,
    "action": 66416,
    "group": "513:49",
    "speaker": "Руки",
    "ja": "まさかとは思うが、お前は自分に",
    "ru": "Уж не думаешь ли ты,"
  },
  {
    "id": 81424,
    "scene": "513",
    "index": 157,
    "action": 66492,
    "group": "513:49",
    "speaker": "Руки",
    "ja": "それ以上の価値があって",
    "ru": "что у тебя есть иная ценность"
  },
  {
    "id": 81425,
    "scene": "513",
    "index": 158,
    "action": 66560,
    "group": "513:49",
    "speaker": "Руки",
    "ja": "ここにいるとでも思っているのか？",
    "ru": "и поэтому ты здесь?"
  },
  {
    "id": 81427,
    "scene": "513",
    "index": 160,
    "action": 66980,
    "group": "513:50",
    "speaker": "Руки",
    "ja": "もしそうなら、つくづく愚かだな。",
    "ru": "Если да, ты поразительно глупа."
  },
  {
    "id": 81428,
    "scene": "513",
    "index": 161,
    "action": 67060,
    "group": "513:50",
    "speaker": "Руки",
    "ja": "お前という人間は。",
    "ru": "Как человек."
  },
  {
    "id": 81430,
    "scene": "513",
    "index": 163,
    "action": 67460,
    "group": "513:51",
    "speaker": "Руки",
    "ja": "愛されたいと思うなら……",
    "ru": "Если хочешь, чтобы тебя любили..."
  },
  {
    "id": 81431,
    "scene": "513",
    "index": 164,
    "action": 67532,
    "group": "513:51",
    "speaker": "Руки",
    "ja": "それに見合うだけのものを差し出せ。",
    "ru": "отдай нечто равноценное."
  },
  {
    "id": 81432,
    "scene": "513",
    "index": 165,
    "action": 67612,
    "group": "513:51",
    "speaker": "Руки",
    "ja": "そう、たとえば――",
    "ru": "Например..."
  },
  {
    "id": 81434,
    "scene": "513",
    "index": 167,
    "action": 67824,
    "group": "513:52",
    "speaker": "Руки",
    "ja": "その首から流れている血を",
    "ru": "Вытри пальцем кровь, текущую с шеи,"
  },
  {
    "id": 81435,
    "scene": "513",
    "index": 168,
    "action": 67896,
    "group": "513:52",
    "speaker": "Руки",
    "ja": "お前の指で拭い、俺に差し出すんだ。",
    "ru": "и поднеси ее мне."
  },
  {
    "id": 81437,
    "scene": "513",
    "index": 170,
    "action": 68176,
    "group": "513:53",
    "speaker": "#Name[2]",
    "ja": "な、にそれ……！",
    "ru": "Ч-что это еще такое?!"
  },
  {
    "id": 81439,
    "scene": "513",
    "index": 172,
    "action": 68576,
    "group": "513:54",
    "speaker": "Руки",
    "ja": "俺はお前の血だけは評価している。",
    "ru": "Я признаю ценность лишь твоей крови."
  },
  {
    "id": 81440,
    "scene": "513",
    "index": 173,
    "action": 68656,
    "group": "513:54",
    "speaker": "Руки",
    "ja": "つまり、俺に気に入られたいのなら",
    "ru": "Если хочешь мне понравиться,"
  },
  {
    "id": 81441,
    "scene": "513",
    "index": 174,
    "action": 68736,
    "group": "513:54",
    "speaker": "Руки",
    "ja": "方法はただひとつ。",
    "ru": "способ только один."
  },
  {
    "id": 81443,
    "scene": "513",
    "index": 176,
    "action": 68948,
    "group": "513:55",
    "speaker": "Руки",
    "ja": "その血を一滴でも多く",
    "ru": "Отдавай мне"
  },
  {
    "id": 81444,
    "scene": "513",
    "index": 177,
    "action": 69016,
    "group": "513:55",
    "speaker": "Руки",
    "ja": "差し出すことだ。",
    "ru": "как можно больше этой крови."
  },
  {
    "id": 81446,
    "scene": "513",
    "index": 179,
    "action": 69416,
    "group": "513:56",
    "speaker": "Руки",
    "ja": "……どうした、やらないのか？",
    "ru": "...Что такое, не станешь?"
  },
  {
    "id": 81447,
    "scene": "513",
    "index": 180,
    "action": 69492,
    "group": "513:56",
    "speaker": "Руки",
    "ja": "俺は何も、自分を傷つけて血を出せと",
    "ru": "Я ведь не говорю ранить себя"
  },
  {
    "id": 81448,
    "scene": "513",
    "index": 181,
    "action": 69572,
    "group": "513:56",
    "speaker": "Руки",
    "ja": "言っているわけではないんだぞ？",
    "ru": "ради крови."
  },
  {
    "id": 81450,
    "scene": "513",
    "index": 183,
    "action": 69796,
    "group": "513:57",
    "speaker": "Руки",
    "ja": "すでに流れている血を拭って、",
    "ru": "Просто вытри уже текущую кровь"
  },
  {
    "id": 81451,
    "scene": "513",
    "index": 184,
    "action": 69872,
    "group": "513:57",
    "speaker": "Руки",
    "ja": "俺の舌へ運ぶ……それだけのことだ。",
    "ru": "и поднеси к моему языку."
  },
  {
    "id": 81452,
    "scene": "513",
    "index": 185,
    "action": 69952,
    "group": "513:57",
    "speaker": "Руки",
    "ja": "痛みなど何も感じない。",
    "ru": "Боли ты не почувствуешь."
  },
  {
    "id": 81454,
    "scene": "513",
    "index": 187,
    "action": 70092,
    "group": "513:58",
    "speaker": "#Name[2]",
    "ja": "私は別に、あなたに気に入られたい",
    "ru": "Я вовсе не хочу,"
  },
  {
    "id": 81455,
    "scene": "513",
    "index": 188,
    "action": 70172,
    "group": "513:58",
    "speaker": "#Name[2]",
    "ja": "わけじゃ……。",
    "ru": "чтобы ты меня любил..."
  },
  {
    "id": 81457,
    "scene": "513",
    "index": 190,
    "action": 70572,
    "group": "513:59",
    "speaker": "Руки",
    "ja": "ほう、そうか。",
    "ru": "Вот как."
  },
  {
    "id": 81458,
    "scene": "513",
    "index": 191,
    "action": 70632,
    "group": "513:59",
    "speaker": "Руки",
    "ja": "では俺もお前に優しくしてやる必要は",
    "ru": "Значит, и мне незачем"
  },
  {
    "id": 81459,
    "scene": "513",
    "index": 192,
    "action": 70712,
    "group": "513:59",
    "speaker": "Руки",
    "ja": "ないというわけだな。",
    "ru": "быть с тобой добрым."
  },
  {
    "id": 81461,
    "scene": "513",
    "index": 194,
    "action": 70976,
    "group": "513:60",
    "speaker": "#Name[2]",
    "ja": "……っ……。",
    "ru": "...!.."
  },
  {
    "id": 81463,
    "scene": "513",
    "index": 196,
    "action": 71376,
    "group": "513:61",
    "speaker": "Руки",
    "ja": "仕方ない。お前がそういう扱いを",
    "ru": "Что ж. Если ты хочешь"
  },
  {
    "id": 81464,
    "scene": "513",
    "index": 197,
    "action": 71452,
    "group": "513:61",
    "speaker": "Руки",
    "ja": "望んでいるならば、応えてやろう。",
    "ru": "такого обращения, я отвечу на желание."
  },
  {
    "id": 81466,
    "scene": "513",
    "index": 199,
    "action": 71680,
    "group": "513:62",
    "speaker": "Руки",
    "ja": "家畜は……主人の役に立ちさえ",
    "ru": "Скот должен лишь"
  },
  {
    "id": 81467,
    "scene": "513",
    "index": 200,
    "action": 71756,
    "group": "513:62",
    "speaker": "Руки",
    "ja": "すれば、それでいい。",
    "ru": "быть полезен хозяину."
  },
  {
    "id": 81469,
    "scene": "513",
    "index": 202,
    "action": 72020,
    "group": "513:63",
    "speaker": "#Name[2]",
    "ja": "や、……。",
    "ru": "Н-не..."
  },
  {
    "id": 81471,
    "scene": "513",
    "index": 204,
    "action": 72652,
    "group": "513:64",
    "speaker": "Руки",
    "ja": "さあ、もっと血を吸わせろ。",
    "ru": "Давай, дай мне еще крови."
  },
  {
    "id": 81472,
    "scene": "513",
    "index": 205,
    "action": 72724,
    "group": "513:64",
    "speaker": "Руки",
    "ja": "お前の価値はそれ以外に",
    "ru": "Другой ценности"
  },
  {
    "id": 81473,
    "scene": "513",
    "index": 206,
    "action": 72792,
    "group": "513:64",
    "speaker": "Руки",
    "ja": "ないのだからな……。",
    "ru": "у тебя все равно нет..."
  }
]
