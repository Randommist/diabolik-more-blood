[
  {
    "id": 393,
    "index": 405,
    "group": "101:124",
    "ja": "教会の神父を務めていた父の海外転勤がきっかけで、",
    "ru": "Из-за перевода отца-священника за границу"
  },
  {
    "id": 394,
    "index": 406,
    "group": "101:124",
    "ja": "ここ、逆巻家に来てからほぼひと月。",
    "ru": "я живу у Сакамаки уже почти месяц."
  },
  {
    "id": 395,
    "index": 408,
    "group": "101:125",
    "ja": "お世話になっている身でこんなことを言うのは",
    "ru": "Неловко говорить такое о тех, кто меня приютил,"
  },
  {
    "id": 396,
    "index": 409,
    "group": "101:125",
    "ja": "失礼かもしれないけど、逆巻家に住んでいる",
    "ru": "но люди, живущие в доме Сакамаки,"
  },
  {
    "id": 397,
    "index": 410,
    "group": "101:125",
    "ja": "人たちは、少し変わっている。",
    "ru": "немного странные."
  },
  {
    "id": 398,
    "index": 412,
    "group": "101:126",
    "ja": "さっき、私のベッドで寝ていたのが、",
    "ru": "Только что в моей постели спали тройняшки:"
  },
  {
    "id": 399,
    "index": 413,
    "group": "101:126",
    "ja": "三つ子のアヤトくん、カナトくん、ライトくん。",
    "ru": "Аято-кун, Канато-кун и Райто-кун."
  },
  {
    "id": 400,
    "index": 415,
    "group": "101:127",
    "ja": "途中で注意しに来たのが、",
    "ru": "Потом пришел сделать им замечание"
  },
  {
    "id": 401,
    "index": 416,
    "group": "101:127",
    "ja": "次男のレイジさん。",
    "ru": "второй по старшинству, Рейджи-сан."
  },
  {
    "id": 402,
    "index": 418,
    "group": "101:128",
    "ja": "それから、まだ今日は顔を合わせて",
    "ru": "А еще я сегодня пока не видела"
  },
  {
    "id": 403,
    "index": 419,
    "group": "101:128",
    "ja": "いないけど、長男のシュウさんと",
    "ru": "старшего, Шу-сана, и младшего,"
  },
  {
    "id": 404,
    "index": 420,
    "group": "101:128",
    "ja": "末っ子のスバルくんの六人が住んでいる。",
    "ru": "Субару-куна. Всего здесь живут шестеро."
  },
  {
    "id": 405,
    "index": 422,
    "group": "101:129",
    "ja": "嘘みたいな話だけど、彼らは――",
    "ru": "Трудно поверить, но они ―"
  },
  {
    "id": 406,
    "index": 424,
    "group": "101:130",
    "ja": "ヴァンパイアの六人兄弟なのだ。",
    "ru": "шестеро братьев-вампиров."
  },
  {
    "id": 407,
    "index": 426,
    "group": "101:131",
    "ja": "そして私は、特別な血と心臓を持っていると言われ、",
    "ru": "Говорят, у меня особые кровь и сердце."
  },
  {
    "id": 408,
    "index": 427,
    "group": "101:131",
    "ja": "彼らのエサとして監視されて、ここから",
    "ru": "Я для них корм. За мной следят,"
  },
  {
    "id": 409,
    "index": 428,
    "group": "101:131",
    "ja": "逃げることができない状況に置かれている。",
    "ru": "и сбежать отсюда я не могу."
  },
  {
    "id": 410,
    "index": 430,
    "group": "101:132",
    "ja": "普段は、わけありの生徒が通う夜間学校",
    "ru": "Я учусь в вечерней школе «Рэйтэй»"
  },
  {
    "id": 411,
    "index": 431,
    "group": "101:132",
    "ja": "『嶺帝学院高校』へ通っていたり、一見普通の",
    "ru": "для ребят с непростой судьбой."
  },
  {
    "id": 412,
    "index": 432,
    "group": "101:132",
    "ja": "生活をさせてもらっているけれど……。",
    "ru": "С виду я живу как обычно, но…"
  },
  {
    "id": 414,
    "index": 434,
    "group": "101:133",
    "ja": "（はぁ……。ヴァンパイアと暮らしてて、",
    "ru": "(Эх… Живу с вампирами,"
  },
  {
    "id": 415,
    "index": 435,
    "group": "101:133",
    "ja": "　しかも血まで吸われてるなんて、",
    "ru": "которые ещё и пьют мою кровь…"
  },
  {
    "id": 416,
    "index": 436,
    "group": "101:133",
    "ja": "　全然普通じゃないよね……）",
    "ru": "Какая уж тут обычная жизнь…)"
  },
  {
    "id": 418,
    "index": 438,
    "group": "101:134",
    "ja": "（それにしても……レイジさん、",
    "ru": "(Но почему Рейджи-сан вдруг"
  },
  {
    "id": 419,
    "index": 439,
    "group": "101:134",
    "ja": "　どうしていきなり私の心臓のこと",
    "ru": "спросил о моём сердце?"
  },
  {
    "id": 420,
    "index": 440,
    "group": "101:134",
    "ja": "　なんて聞いたんだろう……？）",
    "ru": "С чего это он?..)"
  },
  {
    "id": 421,
    "index": 441,
    "group": "101:135",
    "ja": "……ここへ来てから知ったことだけど、",
    "ru": "Я узнала об этом только после приезда:"
  },
  {
    "id": 422,
    "index": 442,
    "group": "101:135",
    "ja": "私の心臓は、偶然にもアヤトくんたち三人の",
    "ru": "мое сердце случайно оказалось пересажено"
  },
  {
    "id": 423,
    "index": 443,
    "group": "101:135",
    "ja": "お母さん、コーデリアから移植されたものらしい。",
    "ru": "от Корделии, матери Аято-куна и его братьев."
  },
  {
    "id": 424,
    "index": 445,
    "group": "101:136",
    "ja": "詳しいことは私にもわからないけど、",
    "ru": "Подробностей я и сама не знаю."
  },
  {
    "id": 425,
    "index": 446,
    "group": "101:136",
    "ja": "彼らの叔父にあたるリヒターという人が",
    "ru": "Говорят, это сделал Рихтер ―"
  },
  {
    "id": 426,
    "index": 447,
    "group": "101:136",
    "ja": "心臓を移植したと言うのだ。",
    "ru": "их дядя."
  },
  {
    "id": 427,
    "index": 449,
    "group": "101:137",
    "ja": "なんでも、コーデリアは魔王の娘という",
    "ru": "Корделия ― дочь Владыки демонов."
  },
  {
    "id": 428,
    "index": 450,
    "group": "101:137",
    "ja": "特殊な血筋で、心臓さえ残っていれば",
    "ru": "У неё особая кровь. Пока сердце"
  },
  {
    "id": 429,
    "index": 451,
    "group": "101:137",
    "ja": "彼女は復活できるという。",
    "ru": "цело, она может воскреснуть."
  },
  {
    "id": 430,
    "index": 453,
    "group": "101:138",
    "ja": "私の血が特別だと言うのも、",
    "ru": "Моя кровь особенная потому,"
  },
  {
    "id": 431,
    "index": 454,
    "group": "101:138",
    "ja": "魔王の娘であるコーデリアの心臓が",
    "ru": "что во мне сердце Корделии,"
  },
  {
    "id": 432,
    "index": 455,
    "group": "101:138",
    "ja": "埋め込まれているからなんだけど……。",
    "ru": "дочери Владыки демонов…"
  },
  {
    "id": 434,
    "index": 457,
    "group": "101:139",
    "ja": "（でも、今更それを気にするのも",
    "ru": "(Но странно вдруг задуматься"
  },
  {
    "id": 435,
    "index": 458,
    "group": "101:139",
    "ja": "　ヘンだよね……？",
    "ru": "об этом только сейчас…"
  },
  {
    "id": 436,
    "index": 459,
    "group": "101:139",
    "ja": "　私の気のせいかな？）",
    "ru": "Может, мне показалось?)"
  },
  {
    "id": 438,
    "index": 461,
    "group": "101:140",
    "ja": "よし、そろそろ行かなくちゃ。",
    "ru": "Так, пора идти."
  },
  {
    "id": 440,
    "index": 463,
    "group": "101:141",
    "ja": "（遅れるとまたレイジさんに",
    "ru": "(Если опоздаю, Рейджи-сан опять"
  },
  {
    "id": 441,
    "index": 464,
    "group": "101:141",
    "ja": "　叱られるもんね）",
    "ru": "будет меня ругать.)"
  },
  {
    "id": 443,
    "index": 466,
    "group": "101:142",
    "ja": "えーっと……忘れ物ないかな……",
    "ru": "Всё взяла? Сегодня японский,"
  },
  {
    "id": 444,
    "index": 467,
    "group": "101:142",
    "ja": "今日はたしか、国語と数学と……",
    "ru": "математика и английский…"
  },
  {
    "id": 445,
    "index": 468,
    "group": "101:142",
    "ja": "英語……辞書は学校にあったっけ？",
    "ru": "Словарь-то остался в школе?"
  },
  {
    "id": 447,
    "index": 470,
    "group": "101:143",
    "ja": "あ、図書室に本も返さないと。",
    "ru": "Ещё вернуть книгу в библиотеку."
  },
  {
    "id": 448,
    "index": 471,
    "group": "101:143",
    "ja": "期限が、確か今日か明日の……。",
    "ru": "Срок вроде сегодня или завтра…"
  }
]
