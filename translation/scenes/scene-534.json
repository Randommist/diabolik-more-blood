    "scene": "534",
    "index": 11,
    "action": 47824,
    "group": "534:3",
    "speaker": "Аято",
    "ja": "うるせぇな。これでオレらの周りを",
    "ru": "Да хватит уже. Теперь по крайней мере"
  },
  {
    "id": 86401,
    "scene": "534",
    "index": 12,
    "action": 47904,
    "group": "534:3",
    "speaker": "Аято",
    "ja": "奴らがうろつくこともなくなんだから",
    "ru": "они больше не будут ошиваться"
  },
  {
    "id": 86402,
    "scene": "534",
    "index": 13,
    "action": 47984,
    "group": "534:3",
    "speaker": "Аято",
    "ja": "いいだろーが。",
    "ru": "вокруг нас. Так что какая разница."
  },
  {
