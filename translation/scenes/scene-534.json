    "action": 49344,
    "group": "534:5",
    "speaker": "#Name[2]",
    "ja": "　伸ばして、私を引き止めてくれた）",
    "ru": "руку и попытался меня удержать.)"
  },
  {
    "id": 86413,
    "scene": "534",
    "index": 24,
    "action": 49496,
    "group": "534:6",
    "speaker": "#Name[2]",
    "ja": "（行くなって、そう言って……）",
    "ru": "(Сказал: «Не уходи»...)"
  },
  {
    "id": 86415,
    "scene": "534",
    "index": 26,
    "action": 49644,
    "group": "534:7",
    "speaker": "#Name[2]",
    "ja": "（……無事だよね。",
    "ru": "(...Он ведь в порядке?"
  },
  {
    "id": 86416,
    "scene": "534",
    "index": 27,
    "action": 49708,
    "group": "534:7",
    "speaker": "#Name[2]",
    "ja": "　だってヴァンパイアだもん）",
    "ru": "Он же вампир.)"
