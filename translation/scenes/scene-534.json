    "action": 49856,
    "group": "534:8",
    "speaker": "#Name[2]",
    "ja": "（きっと生きて――）",
    "ru": "(Наверняка жив―)"
  },
  {
    "id": 86420,
    "scene": "534",
    "index": 31,
    "action": 50152,
    "group": "534:9",
    "speaker": "Рейджи",
    "ja": "――ますか。",
    "ru": "―...аете?"
  },
  {
    "id": 86422,
    "scene": "534",
    "index": 33,
    "action": 50844,
    "group": "534:10",
    "speaker": "Рейджи",
    "ja": "#Name[1]#Name[2]！",
    "ru": "#Name[1]#Name[2]!"
  },
  {
    "id": 86423,
    "scene": "534",
    "index": 34,
    "action": 50908,
    "group": "534:10",
    "speaker": "Рейджи",
    "ja": "聞いてますか！",
    "ru": "Вы меня слушаете?!"
  },
  {
    "id": 86425,
    "scene": "534",
    "index": 36,
    "action": 51132,
    "group": "534:11",
    "speaker": "#Name[2]",
    "ja": "えっ？　あ……すみません。",
    "ru": "Что? А... простите."
  },
  {
    "id": 86427,
    "scene": "534",
    "index": 38,
    "action": 51540,
    "group": "534:12",
    "speaker": "Рейджи",
    "ja": "まったく……心ここにあらず、と",
    "ru": "В самом деле... словно душой вы"
  },
  {
    "id": 86428,
    "scene": "534",
    "index": 39,
    "action": 51616,
    "group": "534:12",
    "speaker": "Рейджи",
    "ja": "言った感じですね。",
    "ru": "совсем не здесь."
  },
  {
    "id": 86429,
    "scene": "534",
    "index": 40,
    "action": 51680,
    "group": "534:12",
    "speaker": "Рейджи",
    "ja": "そんなに気になりますか、彼らが。",
    "ru": "Они так вас беспокоят?"
  },
  {
    "id": 86431,
    "scene": "534",
    "index": 42,
    "action": 52744,
    "group": "534:13",
    "speaker": "#Name[2]",
    "ja": "気になります……。",
    "ru": "Беспокоят..."
  },
  {
    "id": 86433,
    "scene": "534",
    "index": 44,
    "action": 52956,
    "group": "534:14",
    "speaker": "Рейджи",
    "ja": "まあ当然でしょうね。生きていたら",
    "ru": "Ну, это естественно. Если они живы,"
  },
  {
    "id": 86434,
    "scene": "534",
    "index": 45,
    "action": 53036,
    "group": "534:14",
    "speaker": "Рейджи",
    "ja": "またいつ来るかわかりませんし。",
    "ru": "неизвестно, когда снова явятся."
  },
  {
    "id": 86436,
    "scene": "534",
    "index": 47,
    "action": 53692,
    "group": "534:15",
    "speaker": "Канато",
    "ja": "灰になる瞬間まで見届けてくれば",
    "ru": "Надо было посмотреть,"
  },
  {
    "id": 86437,
    "scene": "534",
    "index": 48,
    "action": 53768,
    "group": "534:15",
    "speaker": "Канато",
    "ja": "良かったのに。",
    "ru": "как они обращаются в пепел."
  },
  {
    "id": 86439,
    "scene": "534",
    "index": 50,
    "action": 54576,
    "group": "534:16",
    "speaker": "#Name[2]",
    "ja": "わかりません……。",
    "ru": "Я не знаю..."
  },
  {
    "id": 86441,
    "scene": "534",
    "index": 52,
    "action": 55220,
    "group": "534:17",
    "speaker": "Шу",
    "ja": "わからないって……。",
    "ru": "«Не знаю»..."
  },
  {
    "id": 86442,
    "scene": "534",
    "index": 53,
    "action": 55288,
    "group": "534:17",
    "speaker": "Шу",
    "ja": "情でも湧いたのか……相変わらずだな。",
    "ru": "Ты к ним привязалась? Всё как всегда."
  },
  {
    "id": 86444,
    "scene": "534",
    "index": 55,
    "action": 56480,
    "group": "534:18",
    "speaker": "Субару",
    "ja": "でも燃やしたんだろ？　屋敷ごと。",
    "ru": "Но ты ведь сжёг"
  },
  {
    "id": 86446,
    "scene": "534",
    "index": 57,
    "action": 57140,
    "group": "534:19",
    "speaker": "Аято",
    "ja": "ああ、それは間違いねぇ。",
    "ru": "весь особняк, да?"
  },
  {
    "id": 86447,
    "scene": "534",
    "index": 58,
    "action": 57212,
    "group": "534:19",
    "speaker": "Аято",
    "ja": "この目で見てきたからな。",
    "ru": "Да. Я сам это видел."
  },
  {
    "id": 86449,
    "scene": "534",
    "index": 60,
    "action": 57864,
    "group": "534:20",
    "speaker": "Рейджи",
    "ja": "彼らもヴァンパイアですから",
    "ru": "Они тоже вампиры,"
  },
  {
    "id": 86450,
    "scene": "534",
    "index": 61,
    "action": 57936,
    "group": "534:20",
    "speaker": "Рейджи",
    "ja": "普通の人間よりは丈夫でしょうが、",
    "ru": "и крепче обычных людей,"
  },
  {
    "id": 86451,
    "scene": "534",
    "index": 62,
    "action": 58016,
    "group": "534:20",
    "speaker": "Рейджи",
    "ja": "所詮は純血を持たないはみ出し者。",
    "ru": "но всё же отщепенцы без чистой крови."
  },
  {
    "id": 86453,
    "scene": "534",
    "index": 64,
    "action": 58244,
    "group": "534:21",
    "speaker": "Рейджи",
    "ja": "おそらく彼らの命はそう強くない。",
    "ru": "Жизненная сила у них, вероятно, невелика."
  },
  {
    "id": 86454,
    "scene": "534",
    "index": 65,
    "action": 58324,
    "group": "534:21",
    "speaker": "Рейджи",
    "ja": "炎に巻かれたとなれば、さすがに",
    "ru": "Если их охватило пламя,"
  },
  {
    "id": 86455,
    "scene": "534",
    "index": 66,
    "action": 58400,
    "group": "534:21",
    "speaker": "Рейджи",
    "ja": "助かりはしないでしょう。",
    "ru": "едва ли они могли спастись."
  },
  {
    "id": 86457,
    "scene": "534",
    "index": 68,
    "action": 58808,
    "group": "534:22",
    "speaker": "Рейджи",
    "ja": "もう大丈夫ですから、貴女も",
    "ru": "Теперь всё в порядке, так что и вам"
  },
  {
    "id": 86458,
    "scene": "534",
    "index": 69,
    "action": 58880,
    "group": "534:22",
    "speaker": "Рейджи",
    "ja": "安心していいですよ。",
    "ru": "не о чем тревожиться."
  },
  {
    "id": 86460,
    "scene": "534",
    "index": 71,
    "action": 59528,
    "group": "534:23",
    "speaker": "Канато",
    "ja": "ふふっ……天罰ですよ。",
    "ru": "Хи-хи... Небесная кара."
  },
  {
    "id": 86461,
    "scene": "534",
    "index": 72,
    "action": 59596,
    "group": "534:23",
    "speaker": "Канато",
    "ja": "人のものを取ろうとするから。",
    "ru": "Нечего покушаться на чужое."
  },
  {
    "id": 86463,
    "scene": "534",
    "index": 74,
    "action": 60256,
    "group": "534:24",
    "speaker": "Райто",
    "ja": "きっとビッチちゃんにあれこれ",
    "ru": "Наверняка они много"
  },
  {
    "id": 86464,
    "scene": "534",
    "index": 75,
    "action": 60332,
    "group": "534:24",
    "speaker": "Райто",
    "ja": "酷いことしたんだろうからねぇ。",
    "ru": "всякого ужасного делали со Стервочкой."
  },
  {
    "id": 86465,
    "scene": "534",
    "index": 76,
    "action": 60408,
    "group": "534:24",
    "speaker": "Райто",
    "ja": "かわいそーなビッチちゃん。んふっ。",
    "ru": "Бедная Стервочка. Хи-хи."
  },
  {
    "id": 86467,
    "scene": "534",
    "index": 78,
    "action": 61216,
    "group": "534:25",
    "speaker": "Аято",
    "ja": "要するに、それを救ってやった",
    "ru": "Короче, я, спасший её,"
  },
  {
    "id": 86468,
    "scene": "534",
    "index": 79,
    "action": 61292,
    "group": "534:25",
    "speaker": "Аято",
    "ja": "オレ様はヒーローってこったな！",
    "ru": "выходит, герой!"
  },
  {
    "id": 86469,
    "scene": "534",
    "index": 80,
    "action": 61368,
    "group": "534:25",
    "speaker": "Аято",
    "ja": "感謝しろよ、チチナシ！",
    "ru": "Благодари меня, Плоскогрудая!"
  },
  {
    "id": 86471,
    "scene": "534",
    "index": 82,
    "action": 62016,
    "group": "534:26",
    "speaker": "Субару",
    "ja": "くっだらね……。",
    "ru": "Какая чушь..."
  },
  {
    "id": 86473,
    "scene": "534",
    "index": 84,
    "action": 62420,
    "group": "534:27",
    "speaker": "Аято",
    "ja": "あぁゞ",
    "ru": "Чего?!"
  },
  {
    "id": 86475,
    "scene": "534",
    "index": 86,
    "action": 63052,
    "group": "534:28",
    "speaker": "Рейджи",
    "ja": "まぁ何にせよ、ヴァンパイアの",
    "ru": "Как бы то ни было, приятно,"
  },
  {
    "id": 86476,
    "scene": "534",
    "index": 87,
    "action": 63128,
    "group": "534:28",
    "speaker": "Рейджи",
    "ja": "紛い物が消えて清々しました。",
    "ru": "что поддельные вампиры исчезли."
  },
  {
    "id": 86478,
    "scene": "534",
    "index": 89,
    "action": 63540,
    "group": "534:29",
    "speaker": "Рейджи",
    "ja": "それについては仕方ありませんが",
    "ru": "Что до этого, тут уж ничего не поделать,"
  },
  {
    "id": 86479,
    "scene": "534",
    "index": 90,
    "action": 63616,
    "group": "534:29",
    "speaker": "Рейджи",
    "ja": "褒めて差し上げますよ、アヤト。",
    "ru": "но похвалю вас, Аято."
  },
  {
    "id": 86480,
    "scene": "534",
    "index": 91,
    "action": 63692,
    "group": "534:29",
    "speaker": "Рейджи",
    "ja": "私の頭痛の種も減る。",
    "ru": "Одной причиной головной боли меньше."
  },
  {
    "id": 86482,
    "scene": "534",
    "index": 93,
    "action": 64096,
    "group": "534:30",
    "speaker": "Аято",
    "ja": "テメェに褒められても嬉しく",
    "ru": "Да мне от твоей похвалы ни жарко"
  },
  {
    "id": 86483,
    "scene": "534",
    "index": 94,
    "action": 64168,
    "group": "534:30",
    "speaker": "Аято",
    "ja": "ねーっつの。褒美と言や、チチナシの",
    "ru": "ни холодно. Если уж о награде ― кроме крови"
  },
  {
    "id": 86484,
    "scene": "534",
    "index": 95,
    "action": 64248,
    "group": "534:30",
    "speaker": "Аято",
    "ja": "血以外、有り得ねぇだろ。",
    "ru": "Плоскогрудой ничего не годится."
  },
  {
    "id": 86486,
    "scene": "534",
    "index": 97,
    "action": 64656,
    "group": "534:31",
    "speaker": "Рейджи",
    "ja": "彼女は散々無体を強いられていた",
    "ru": "Её долго жестоко мучили,"
  },
  {
    "id": 86487,
    "scene": "534",
    "index": 98,
    "action": 64732,
    "group": "534:31",
    "speaker": "Рейджи",
    "ja": "んですよ、アヤト。今夜くらいは",
    "ru": "Аято. Хотя бы сегодня ночью"
  },
  {
    "id": 86488,
    "scene": "534",
    "index": 99,
    "action": 64808,
    "group": "534:31",
    "speaker": "Рейджи",
    "ja": "ゆっくり休ませてあげなさい。",
    "ru": "дайте ей спокойно отдохнуть."
  },
  {
    "id": 86490,
    "scene": "534",
    "index": 101,
    "action": 65224,
    "group": "534:32",
    "speaker": "Аято",
    "ja": "はあぁ？　冗談じゃねぇ！",
    "ru": "А-а?! Да не смеши!"
  },
  {
    "id": 86491,
    "scene": "534",
    "index": 102,
    "action": 65296,
    "group": "534:32",
    "speaker": "Аято",
    "ja": "オレがどんだけコイツの血ィ",
    "ru": "Ты хоть знаешь, сколько времени"
  },
  {
    "id": 86492,
    "scene": "534",
    "index": 103,
    "action": 65368,
    "group": "534:32",
    "speaker": "Аято",
    "ja": "吸ってねぇと思ってんだ！",
    "ru": "я не пил её кровь?!"
  },
  {
    "id": 86494,
    "scene": "534",
    "index": 105,
    "action": 65776,
    "group": "534:33",
    "speaker": "Рейджи",
    "ja": "どうせ今夜も四人に寄って集って",
    "ru": "Наверняка и сегодня ночью четверо"
  },
  {
    "id": 86495,
    "scene": "534",
    "index": 106,
    "action": 65852,
    "group": "534:33",
    "speaker": "Рейджи",
    "ja": "吸われていたんでしょう。血が",
    "ru": "навалились на неё и сосали кровь. Дай хотя бы"
  },
  {
    "id": 86496,
    "scene": "534",
    "index": 107,
    "action": 65928,
    "group": "534:33",
    "speaker": "Рейджи",
    "ja": "めぐる時間くらい与えたらどうです。",
    "ru": "времени, чтобы кровь восстановилась."
  },
  {
    "id": 86498,
    "scene": "534",
    "index": 109,
    "action": 66588,
    "group": "534:34",
    "speaker": "Райто",
    "ja": "あーあ、アヤトくんに任せないで",
    "ru": "Эх, надо было не Аято-куна отправлять,"
  },
  {
    "id": 86499,
    "scene": "534",
    "index": 110,
