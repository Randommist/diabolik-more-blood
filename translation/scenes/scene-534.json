    "scene": "534",
    "index": 3,
    "action": 45984,
    "group": "534:0",
    "speaker": "Райто",
    "ja": "ビッチちゃんを、ここまで。",
    "ru": "И привезли Стервочку сюда."
  },
  {
    "id": 86394,
    "scene": "534",
    "index": 5,
    "action": 46636,
    "group": "534:1",
    "speaker": "Аято",
    "ja": "まぁな。",
    "ru": "Ну да."
