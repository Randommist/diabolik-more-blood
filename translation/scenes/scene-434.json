  },
  {
    "id": 61623,
    "scene": "434",
    "index": 3,
    "action": 46324,
    "group": "434:0",
    "speaker": "Шу",
    "ja": "…………。",
    "ru": "............"
  },
  {
    "id": 61625,
    "scene": "434",
    "index": 5,
    "action": 46576,
    "group": "434:0",
    "speaker": "#Name[2]",
    "ja": "ふたりとも……止めてください……",
    "ru": "Вы оба... прекратите..."
  },
  {
    "id": 61626,
    "scene": "434",
    "index": 6,
    "action": 46656,
    "group": "434:0",
    "speaker": "#Name[2]",
    "ja": "こんなの……おかしい……。",
    "ru": "Это... неправильно..."
  },
  {
    "id": 61628,
    "scene": "434",
    "index": 8,
    "action": 46984,
    "group": "434:1",
    "speaker": "Рейджи",
    "ja": "…………。",
    "ru": "............"
  },
  {
    "id": 61630,
    "scene": "434",
    "index": 10,
    "action": 47376,
    "group": "434:1",
    "speaker": "Шу",
    "ja": "おい……レイジ、お前……コイツの",
    "ru": "Эй... Рейджи, ты..."
  },
  {
    "id": 61631,
    "scene": "434",
    "index": 11,
    "action": 47456,
    "group": "434:1",
    "speaker": "Шу",
    "ja": "ことが特別なんだろ？",
    "ru": "считаешь её особенной, да?"
  },
  {
    "id": 61633,
    "scene": "434",
    "index": 13,
    "action": 47860,
    "group": "434:2",
    "speaker": "Рейджи",
    "ja": "ハッ……馬鹿馬鹿しい。",
    "ru": "Ха... Какая глупость."
  },
  {
    "id": 61634,
    "scene": "434",
    "index": 14,
    "action": 47928,
    "group": "434:2",
    "speaker": "Рейджи",
    "ja": "特別だのなんだの……私は……",
    "ru": "Особенная или нет... Я..."
  },
  {
    "id": 61635,
    "scene": "434",
    "index": 15,
    "action": 48004,
    "group": "434:2",
    "speaker": "Рейджи",
    "ja": "そんな個人的欲求など……。",
    "ru": "не руководствуюсь такими личными желаниями."
  },
  {
    "id": 61637,
    "scene": "434",
    "index": 17,
    "action": 48540,
    "group": "434:3",
    "speaker": "Шу",
    "ja": "五月蠅い……そろそろ認めろ。",
    "ru": "Хватит... Пора признать."
  },
  {
    "id": 61638,
    "scene": "434",
    "index": 18,
    "action": 48616,
    "group": "434:3",
    "speaker": "Шу",
    "ja": "見え見えなんだよ。",
    "ru": "Это и так очевидно."
  },
  {
    "id": 61640,
    "scene": "434",
    "index": 20,
    "action": 49020,
    "group": "434:4",
    "speaker": "Рейджи",
    "ja": "貴方のような……欲望の権化に",
    "ru": "Не тебе говорить мне это..."
  },
  {
    "id": 61641,
    "scene": "434",
    "index": 21,
    "action": 49096,
    "group": "434:4",
    "speaker": "Рейджи",
    "ja": "言われたくない。人間以下の畜生め。",
    "ru": "животному, ставшему рабом желаний."
  },
  {
    "id": 61643,
    "scene": "434",
    "index": 23,
    "action": 49512,
    "group": "434:5",
    "speaker": "Шу",
    "ja": "ああ……そうだ。それの何が悪い。",
    "ru": "Да... так и есть. И что плохого?"
  },
  {
    "id": 61645,
    "scene": "434",
    "index": 25,
    "action": 49928,
    "group": "434:6",
    "speaker": "Рейджи",
    "ja": "っ……ことに及んで開き直り",
    "ru": "...Теперь просто"
  },
  {
    "id": 61646,
    "scene": "434",
    "index": 26,
    "action": 50000,
    "group": "434:6",
    "speaker": "Рейджи",
    "ja": "ですか？",
    "ru": "оправдываешься?"
  },
  {
    "id": 61648,
    "scene": "434",
    "index": 28,
    "action": 50204,
    "group": "434:7",
    "speaker": "Шу",
    "ja": "ヴァンパイアの誇りってヤツを",
    "ru": "Я не отрицаю эту вашу"
  },
  {
    "id": 61649,
    "scene": "434",
    "index": 29,
    "action": 50280,
    "group": "434:7",
    "speaker": "Шу",
    "ja": "別に俺は否定しない。お前の好きに",
    "ru": "«вампирскую гордость». Делай, как"
  },
  {
    "id": 61650,
    "scene": "434",
    "index": 30,
    "action": 50360,
    "group": "434:7",
    "speaker": "Шу",
    "ja": "すればいい。",
    "ru": "хочешь."
  },
  {
    "id": 61652,
    "scene": "434",
    "index": 32,
    "action": 50760,
    "group": "434:8",
    "speaker": "Шу",
    "ja": "その力を使って、世界征服でも",
    "ru": "Используй свою силу и"
  },
  {
    "id": 61653,
    "scene": "434",
    "index": 33,
    "action": 50836,
    "group": "434:8",
    "speaker": "Шу",
    "ja": "なんでも、勝手にしろ。",
    "ru": "захвати мир, если нравится."
  },
  {
    "id": 61654,
    "scene": "434",
    "index": 34,
    "action": 50904,
    "group": "434:8",
    "speaker": "Шу",
    "ja": "……だが、俺は興味がない。",
    "ru": "...Мне всё равно."
  },
  {
    "id": 61656,
    "scene": "434",
    "index": 36,
    "action": 51680,
    "group": "434:9",
    "speaker": "Рейджи",
    "ja": "そう出来るだけの力があるにも",
    "ru": "Хотя у тебя есть сила,"
  },
  {
    "id": 61657,
    "scene": "434",
    "index": 37,
    "action": 51756,
    "group": "434:9",
    "speaker": "Рейджи",
    "ja": "関わらず……！",
    "ru": "достаточная для этого...!"
  },
  {
    "id": 61658,
    "scene": "434",
    "index": 38,
    "action": 51816,
    "group": "434:9",
    "speaker": "Рейджи",
    "ja": "それは力を持った者の義務だ。",
    "ru": "Это обязанность того, кто ей обладает."
  },
  {
    "id": 61660,
    "scene": "434",
    "index": 40,
    "action": 52040,
    "group": "434:10",
    "speaker": "Рейджи",
    "ja": "この家に生まれた、責任だ！",
    "ru": "Ответственность того, кто родился в этом доме!"
  },
  {
    "id": 61662,
    "scene": "434",
    "index": 42,
    "action": 52448,
    "group": "434:11",
    "speaker": "Шу",
    "ja": "オヤジは……お前の敬愛する",
    "ru": "А отец..."
  },
  {
    "id": 61663,
    "scene": "434",
    "index": 43,
    "action": 52520,
    "group": "434:11",
    "speaker": "Шу",
    "ja": "カールハインツは……そいつを",
    "ru": "твой обожаемый Карлхайнц..."
  },
  {
    "id": 61664,
    "scene": "434",
    "index": 44,
    "action": 52596,
    "group": "434:11",
    "speaker": "Шу",
    "ja": "俺たちに望んでんのか……？",
    "ru": "он правда хочет этого от нас?"
  },
  {
    "id": 61666,
    "scene": "434",
    "index": 46,
    "action": 52816,
    "group": "434:12",
    "speaker": "Рейджи",
    "ja": "……だからだ。",
    "ru": "...Именно поэтому."
  },
  {
    "id": 61667,
    "scene": "434",
    "index": 47,
    "action": 52876,
    "group": "434:12",
    "speaker": "Рейджи",
    "ja": "だから……私は父上も許せない。",
    "ru": "И потому... я не могу простить даже отца."
  },
  {
    "id": 61669,
    "scene": "434",
    "index": 49,
    "action": 53100,
    "group": "434:13",
    "speaker": "Рейджи",
    "ja": "ヴァンパイアの王たる資格など……",
    "ru": "Он не достоин"
  },
  {
    "id": 61670,
    "scene": "434",
    "index": 50,
    "action": 53180,
    "group": "434:13",
    "speaker": "Рейджи",
    "ja": "あの方にはないんだ！",
    "ru": "быть королём вампиров!"
  },
  {
    "id": 61672,
    "scene": "434",
    "index": 52,
    "action": 53668,
    "group": "434:14",
    "speaker": "Шу",
    "ja": "この……分からず屋が……。",
    "ru": "Вот же... упрямец..."
  },
  {
    "id": 61674,
    "scene": "434",
    "index": 54,
    "action": 54128,
    "group": "434:15",
    "speaker": "#Name[2]",
    "ja": "くっ……ゝ",
    "ru": "Кх...!"
  },
  {
    "id": 61676,
    "scene": "434",
    "index": 56,
    "action": 54520,
    "group": "434:16",
    "speaker": "Рейджи",
    "ja": "#Name[2]ゝ",
    "ru": "#Name[2]!"
  },
  {
    "id": 61678,
    "scene": "434",
    "index": 58,
    "action": 54912,
    "group": "434:17",
    "speaker": "Шу",
    "ja": "俺は……お前から、逃げてた。",
    "ru": "Я... всё это время убегал от тебя."
  },
  {
    "id": 61680,
    "scene": "434",
    "index": 60,
    "action": 55324,
    "group": "434:18",
    "speaker": "Рейджи",
    "ja": "……！",
    "ru": "...!"
  },
  {
    "id": 61682,
    "scene": "434",
    "index": 62,
    "action": 55712,
    "group": "434:18",
    "speaker": "Шу",
    "ja": "俺が我慢していればいいんだと。",
    "ru": "Думал, что достаточно терпеть самому."
  },
  {
    "id": 61683,
    "scene": "434",
    "index": 63,
    "action": 55788,
    "group": "434:18",
    "speaker": "Шу",
    "ja": "お前を無視していれば……、",
    "ru": "Что если просто игнорировать тебя..."
  },
  {
    "id": 61684,
    "scene": "434",
    "index": 64,
    "action": 55860,
    "group": "434:18",
    "speaker": "Шу",
    "ja": "向き合う必要なんてないと……。",
    "ru": "то можно не смотреть тебе в лицо..."
  },
  {
    "id": 61686,
    "scene": "434",
    "index": 66,
    "action": 56272,
    "group": "434:19",
    "speaker": "Шу",
    "ja": "けど……そいつは間違いだった。",
    "ru": "Но... это было ошибкой."
  },
  {
    "id": 61687,
    "scene": "434",
    "index": 67,
    "action": 56348,
    "group": "434:19",
    "speaker": "Шу",
    "ja": "俺は……もっと……お前と向き合う",
    "ru": "Я должен был..."
  },
  {
    "id": 61688,
    "scene": "434",
    "index": 68,
    "action": 56428,
    "group": "434:19",
    "speaker": "Шу",
    "ja": "べきだった。",
    "ru": "раньше поговорить с тобой по-настоящему."
  },
  {
    "id": 61690,
    "scene": "434",
    "index": 70,
    "action": 56636,
    "group": "434:20",
    "speaker": "Шу",
    "ja": "これは俺が目をそらし続け、",
    "ru": "Это расплата за то, что я всё время отворачивался"
  },
  {
    "id": 61691,
    "scene": "434",
    "index": 71,
    "action": 56708,
    "group": "434:20",
    "speaker": "Шу",
    "ja": "お前を無視し続けてきた報いだ……。",
    "ru": "и продолжал тебя игнорировать..."
  },
  {
    "id": 61693,
    "scene": "434",
    "index": 73,
    "action": 57124,
    "group": "434:21",
    "speaker": "Рейджи",
    "ja": "今更……何を言ってる……。",
    "ru": "Теперь-то... что ты говоришь..."
  },
  {
    "id": 61695,
    "scene": "434",
    "index": 75,
    "action": 57344,
    "group": "434:22",
    "speaker": "Шу",
    "ja": "分かり合えないまでも……お前の",
    "ru": "Пусть мы бы и не поняли друг друга..."
  },
  {
    "id": 61696,
    "scene": "434",
    "index": 76,
    "action": 57420,
    "group": "434:22",
    "speaker": "Шу",
    "ja": "ことを……認めるくらいのことは",
    "ru": "но хотя бы признать тебя таким, какой ты есть,"
  },
  {
    "id": 61697,
    "scene": "434",
    "index": 77,
    "action": 57496,
    "group": "434:22",
    "speaker": "Шу",
    "ja": "できた。",
    "ru": "я мог."
  },
  {
    "id": 61699,
    "scene": "434",
    "index": 79,
    "action": 57748,
    "group": "434:23",
    "speaker": "#Name[2]",
    "ja": "シュウ……さん……。",
    "ru": "Шу...-сан..."
  },
  {
    "id": 61701,
    "scene": "434",
    "index": 81,
    "action": 58012,
    "group": "434:24",
    "speaker": "#Name[2]",
    "ja": "（首から血が……）",
    "ru": "(У него на шее кровь...)"
  },
  {
    "id": 61703,
    "scene": "434",
    "index": 83,
    "action": 58412,
    "group": "434:25",
    "speaker": "Шу",
    "ja": "いつかこうなるって",
    "ru": "Я ведь понимал, что однажды"
  },
  {
    "id": 61704,
    "scene": "434",
    "index": 84,
    "action": 58476,
    "group": "434:25",
    "speaker": "Шу",
    "ja": "分かってたはずなのに……。",
    "ru": "это закончится так..."
  },
  {
    "id": 61706,
    "scene": "434",
    "index": 86,
    "action": 58884,
    "group": "434:26",
    "speaker": "Рейджи",
    "ja": "分かったような口を。",
    "ru": "Говоришь так, словно всё понимаешь."
  },
  {
    "id": 61708,
    "scene": "434",
    "index": 88,
    "action": 59288,
    "group": "434:27",
    "speaker": "Шу",
    "ja": "分かるに決まってるだろ。",
    "ru": "А я и должен понимать."
  },
  {
    "id": 61710,
    "scene": "434",
    "index": 90,
    "action": 59696,
    "group": "434:28",
    "speaker": "Рейджи",
    "ja": "……え……？",
    "ru": "...Что?"
  },
  {
    "id": 61712,
    "scene": "434",
    "index": 92,
    "action": 60400,
    "group": "434:29",
    "speaker": "Шу",
    "ja": "俺はお前の兄貴だ。誰よりも",
    "ru": "Я твой старший брат. Дольше всех"
  },
  {
    "id": 61713,
    "scene": "434",
    "index": 93,
    "action": 60472,
    "group": "434:29",
    "speaker": "Шу",
    "ja": "長い間、近くでお前を見てきた。",
    "ru": "жил рядом и видел тебя."
  },
  {
    "id": 61715,
    "scene": "434",
    "index": 95,
    "action": 60884,
    "group": "434:30",
    "speaker": "Рейджи",
    "ja": "何を……馬鹿なことを……",
    "ru": "Что за... глупости..."
  },
  {
    "id": 61716,
    "scene": "434",
    "index": 96,
    "action": 60956,
    "group": "434:30",
    "speaker": "Рейджи",
    "ja": "今更、何を言っても無駄です。",
    "ru": "Теперь уже что ни скажи ― поздно."
  },
  {
    "id": 61718,
    "scene": "434",
    "index": 98,
    "action": 61368,
    "group": "434:31",
    "speaker": "Шу",
    "ja": "もう遅いのか……？",
    "ru": "Уже поздно...?"
  },
  {
    "id": 61720,
    "scene": "434",
    "index": 100,
    "action": 61768,
    "group": "434:32",
    "speaker": "Рейджи",
    "ja": "ええ……全てが遅いですね。",
    "ru": "Да... Слишком поздно."
  },
  {
    "id": 61721,
    "scene": "434",
    "index": 101,
    "action": 61840,
    "group": "434:32",
    "speaker": "Рейджи",
    "ja": "私は刃を振り上げてしまった。",
    "ru": "Я уже поднял клинок."
  },
  {
    "id": 61723,
    "scene": "434",
    "index": 103,
    "action": 62252,
    "group": "434:33",
    "speaker": "Рейджи",
    "ja": "この身を滅ぼすまで……、",
    "ru": "Пока не уничтожу себя..."
  },
  {
    "id": 61724,
    "scene": "434",
    "index": 104,
    "action": 62324,
    "group": "434:33",
    "speaker": "Рейджи",
    "ja": "この刃を下げるわけには、",
    "ru": "я больше"
  },
  {
    "id": 61725,
    "scene": "434",
    "index": 105,
    "action": 62396,
    "group": "434:33",
    "speaker": "Рейджи",
    "ja": "もういかない……！",
    "ru": "не смогу его опустить...!"
  },
  {
    "id": 61727,
    "scene": "434",
    "index": 107,
    "action": 62796,
    "group": "434:34",
    "speaker": "Шу",
    "ja": "……なら、俺をやれ。レイジ。",
    "ru": "...Тогда убей меня, Рейджи."
  },
  {
    "id": 61729,
    "scene": "434",
    "index": 109,
    "action": 63208,
    "group": "434:35",
    "speaker": "Рейджи",
    "ja": "貴方のことはいずれにせよ",
    "ru": "С вами я в любом случае"
  },
  {
    "id": 61730,
    "scene": "434",
    "index": 110,
    "action": 63280,
    "group": "434:35",
    "speaker": "Рейджи",
    "ja": "始末します。しかしまずは……",
    "ru": "разберусь. Но сначала..."
  },
  {
    "id": 61731,
    "scene": "434",
    "index": 111,
    "action": 63356,
    "group": "434:35",
    "speaker": "Рейджи",
    "ja": "この男が先だ。",
    "ru": "этот мужчина."
  },
  {
    "id": 61733,
    "scene": "434",
    "index": 113,
    "action": 63564,
    "group": "434:36",
    "speaker": "Юма",
    "ja": "っ……。",
    "ru": "...!"
  },
  {
    "id": 61735,
    "scene": "434",
    "index": 115,
    "action": 63768,
    "group": "434:37",
    "speaker": "Шу",
    "ja": "そいつは……エドガーは……",
    "ru": "Он... Эдгар..."
  },
  {
    "id": 61736,
    "scene": "434",
    "index": 116,
    "action": 63840,
    "group": "434:37",
    "speaker": "Шу",
    "ja": "関係ない。これ以上巻き込むな。",
    "ru": "не при чём. Не втягивай его дальше."
  },
  {
    "id": 61738,
    "scene": "434",
    "index": 118,
    "action": 64252,
    "group": "434:38",
    "speaker": "Рейджи",
    "ja": "ふふ……認めるんですか？",
    "ru": "Ха-ха... Признаёте?"
  },
  {
    "id": 61739,
    "scene": "434",
    "index": 119,
    "action": 64324,
    "group": "434:38",
    "speaker": "Рейджи",
    "ja": "この男が貴方の大事なお友達だと。",
    "ru": "Что этот мужчина ― ваш дорогой друг."
  },
  {
    "id": 61741,
