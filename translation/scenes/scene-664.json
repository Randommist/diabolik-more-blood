  {
    "id": 119450,
    "scene": "664",
    "index": 15,
    "action": 47748,
    "group": "664:6",
    "speaker": "Азуса",
    "ja": "ほら、ここでじっとしてるから",
    "ru": "Вот, я замру на месте,"
