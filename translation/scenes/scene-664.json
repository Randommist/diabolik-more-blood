  {
    "id": 119465,
    "scene": "664",
    "index": 30,
    "action": 49868,
    "group": "664:11",
    "speaker": "Азуса",
    "ja": "どうして、困った顔するの？",
    "ru": "Почему у тебя такое лицо?"
