  {
    "id": 119461,
    "scene": "664",
    "index": 26,
    "action": 49192,
    "group": "664:9",
    "speaker": "Азуса",
    "ja": "顔を殴ってもいいよ。",
    "ru": "Бей прямо по лицу."
  },
  {
    "id": 119463,
    "scene": "664",
    "index": 28,
    "action": 49456,
    "group": "664:10",
    "speaker": "#Name[2]",
    "ja": "ちょ、ちょっと、アズサくん？",
    "ru": "П-погоди, Азуса-кун!"
