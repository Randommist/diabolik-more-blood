  {
    "id": 119457,
    "scene": "664",
    "index": 22,
    "action": 48628,
    "group": "664:8",
    "speaker": "Азуса",
    "ja": "だって俺……君を待たせたんだよ？",
    "ru": "Я ведь... заставил тебя ждать."
