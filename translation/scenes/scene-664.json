  {
    "id": 119454,
    "scene": "664",
    "index": 19,
    "action": 48148,
    "group": "664:7",
    "speaker": "#Name[2]",
    "ja": "そこまでしなくても……。",
    "ru": "зачем же так сразу..."
  },
  {
    "id": 119456,
    "scene": "664",
    "index": 21,
    "action": 48556,
    "group": "664:8",
    "speaker": "Азуса",
    "ja": "なんで？　なんで、いいの？",
    "ru": "Почему? Почему не надо?"
