  {
    "id": 119478,
    "scene": "664",
    "index": 43,
    "action": 51124,
    "group": "664:15",
    "speaker": "#Name[2]",
    "ja": "だから違うってば。",
    "ru": "Да говорю же, не в этом дело!"
