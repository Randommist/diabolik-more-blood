  {
    "id": 119469,
    "scene": "664",
    "index": 34,
    "action": 50152,
    "group": "664:12",
    "speaker": "#Name[2]",
    "ja": "足りないとかじゃなくて。",
    "ru": "Дело вовсе не в \"мало\"."
