  {
    "id": 119484,
    "scene": "664",
    "index": 49,
    "action": 51812,
    "group": "664:17",
    "speaker": "#Name[2]",
    "ja": "　ぜんぜん聞こうとしない。",
    "ru": "не слушает."
  },
  {
    "id": 119485,
    "scene": "664",
    "index": 50,
    "action": 51884,
    "group": "664:17",
    "speaker": "#Name[2]",
    "ja": "　どうしよう……）",
    "ru": "Что же делать?..)"
