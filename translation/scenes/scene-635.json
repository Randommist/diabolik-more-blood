    "speaker": "Юма",
    "ja": "ククッ、まさか。花を見たらまずは",
    "ru": "Ха-ха, да нет. Увидев цветок, они первым делом"
  },
  {
    "id": 111901,
    "scene": "635",
    "index": 127,
    "action": 65568,
    "group": "635:47",
    "speaker": "Юма",
    "ja": "食えるか談義するような連中だぜ？",
    "ru": "спорили, можно ли его съесть."
  },
  {
    "id": 111903,
    "scene": "635",
    "index": 129,
    "action": 66108,
    "group": "635:48",
    "speaker": "Юма",
    "ja": "昔な、食い物と勘違いして",
    "ru": "Когда-то один дурак принял семена розы"
  },
  {
    "id": 111904,
    "scene": "635",
    "index": 130,
    "action": 66180,
    "group": "635:48",
    "speaker": "Юма",
    "ja": "薔薇の種を盗ってきた馬鹿がいてよ。",
    "ru": "за что-то съедобное и стащил их."
  },
  {
    "id": 111906,
    "scene": "635",
    "index": 132,
    "action": 66408,
    "group": "635:49",
    "speaker": "Юма",
    "ja": "それをな、面白がったボスが",
    "ru": "Босса это позабавило,"
  },
  {
    "id": 111907,
    "scene": "635",
    "index": 133,
    "action": 66480,
    "group": "635:49",
    "speaker": "Юма",
    "ja": "ふざけ半分で土に植えたんだよ。",
    "ru": "и он в шутку посадил их в землю."
  },
  {
    "id": 111909,
    "scene": "635",
    "index": 135,
    "action": 66704,
    "group": "635:50",
    "speaker": "Юма",
    "ja": "でも誰も花の世話なんてしたこと",
    "ru": "Но никто из нас никогда не ухаживал"
  },
  {
    "id": 111910,
    "scene": "635",
    "index": 136,
    "action": 66780,
    "group": "635:50",
    "speaker": "Юма",
    "ja": "ねえから、花が咲くどころか",
    "ru": "за цветами, так что роза не то что"
  },
  {
    "id": 111911,
    "scene": "635",
    "index": 137,
    "action": 66852,
    "group": "635:50",
    "speaker": "Юма",
    "ja": "芽すら出なくてな。",
    "ru": "не зацвела - даже не взошла."
  },
  {
    "id": 111913,
    "scene": "635",
    "index": 139,
    "action": 67064,
    "group": "635:51",
    "speaker": "Юма",
    "ja": "あん時は、まあそりゃそうだ、で",
    "ru": "Тогда мы решили: ну и неудивительно."
  },
  {
    "id": 111914,
    "scene": "635",
    "index": 140,
    "action": 67140,
    "group": "635:51",
    "speaker": "Юма",
    "ja": "終わったんだが……そのしばらく後、",
    "ru": "А спустя какое-то время"
  },
  {
    "id": 111915,
    "scene": "635",
    "index": 141,
    "action": 67220,
    "group": "635:51",
    "speaker": "Юма",
    "ja": "薔薇の形をした砂糖ってのを見てよ。",
    "ru": "я увидел сахар в форме розы."
  },
  {
    "id": 111917,
    "scene": "635",
    "index": 143,
    "action": 67736,
    "group": "635:52",
    "speaker": "#Name[2]",
    "ja": "（薔薇の形の、砂糖……）",
    "ru": "(Сахар в форме розы...)"
  },
  {
    "id": 111919,
    "scene": "635",
    "index": 145,
    "action": 67956,
    "group": "635:53",
    "speaker": "Юма",
    "ja": "これがあの時咲くはずだったモンか",
    "ru": "Я подумал: вот что тогда должно было вырасти..."
  },
  {
    "id": 111920,
    "scene": "635",
    "index": 146,
    "action": 68036,
    "group": "635:53",
    "speaker": "Юма",
    "ja": "と思ったら……実物が見たくなって、",
    "ru": "Захотелось увидеть настоящую розу"
  },
  {
    "id": 111921,
    "scene": "635",
    "index": 147,
    "action": 68116,
    "group": "635:53",
    "speaker": "Юма",
    "ja": "アイツらにも見せてやりたくなった。",
    "ru": "и показать её им."
  },
  {
    "id": 111923,
    "scene": "635",
    "index": 149,
    "action": 68532,
    "group": "635:54",
    "speaker": "Юма",
    "ja": "つっても、花なんかより食い物を",
    "ru": "Хотя эти ребята скорее попросили бы"
  },
  {
    "id": 111924,
    "scene": "635",
    "index": 150,
    "action": 68608,
    "group": "635:54",
    "speaker": "Юма",
    "ja": "見せろって言いそうな奴らだからな。",
    "ru": "показать им еду, а не цветок."
  },
  {
    "id": 111925,
    "scene": "635",
    "index": 151,
    "action": 68688,
    "group": "635:54",
    "speaker": "Юма",
    "ja": "自己満足って言やぁそうだけどよ。",
    "ru": "Можно сказать, это просто для себя."
  },
  {
    "id": 111927,
    "scene": "635",
    "index": 153,
    "action": 69104,
    "group": "635:55",
    "speaker": "Юма",
    "ja": "けどまあ……暇潰し程度に空から",
    "ru": "Но я подумал: если они хотя бы от скуки"
  },
  {
    "id": 111928,
    "scene": "635",
    "index": 154,
    "action": 69180,
    "group": "635:55",
    "speaker": "Юма",
    "ja": "見るくらいなら、アイツらも",
    "ru": "посмотрят на неё оттуда сверху,"
  },
  {
    "id": 111929,
    "scene": "635",
    "index": 155,
    "action": 69252,
    "group": "635:55",
    "speaker": "Юма",
    "ja": "喜ぶんじゃねえかと思ったんだ。",
    "ru": "может, им станет приятно."
  },
  {
    "id": 111931,
    "scene": "635",
    "index": 157,
    "action": 69400,
    "group": "635:56",
    "speaker": "#Name[2]",
    "ja": "（そうだったんだ……）",
    "ru": "(Вот как...)"
  },
  {
    "id": 111933,
    "scene": "635",
    "index": 159,
    "action": 69616,
    "group": "635:57",
    "speaker": "Юма",
    "ja": "コイツが咲いてくれれば……一度",
    "ru": "Если она расцветёт..."
  },
  {
    "id": 111934,
    "scene": "635",
    "index": 160,
    "action": 69692,
    "group": "635:57",
    "speaker": "Юма",
    "ja": "ダメだったことも二度目なら実るって",
    "ru": "Может, тогда появится надежда, что и то,"
  },
  {
    "id": 111935,
    "scene": "635",
    "index": 161,
    "action": 69772,
    "group": "635:57",
    "speaker": "Юма",
    "ja": "希望が持てる気がしたんだけどよ。",
    "ru": "что однажды не вышло, получится со второго раза."
  },
  {
    "id": 111937,
    "scene": "635",
    "index": 163,
    "action": 70188,
    "group": "635:58",
    "speaker": "Юма",
    "ja": "なかなか咲かねえモンだぜ。",
    "ru": "А она всё никак не цветёт."
  },
  {
    "id": 111938,
    "scene": "635",
    "index": 164,
    "action": 70260,
    "group": "635:58",
    "speaker": "Юма",
    "ja": "ヴァンパイアになっても、人生は",
    "ru": "Похоже, даже после превращения в вампира"
  },
  {
    "id": 111939,
    "scene": "635",
    "index": 165,
    "action": 70336,
    "group": "635:58",
    "speaker": "Юма",
    "ja": "そこまで甘くねえらしい。",
    "ru": "жизнь не становится такой уж лёгкой."
  },
  {
    "id": 111941,
    "scene": "635",
    "index": 167,
    "action": 70604,
    "group": "635:59",
    "speaker": "#Name[2]",
    "ja": "ユーマくんの希望って……？",
    "ru": "А на что надеется Юма-кун...?"
  },
  {
    "id": 111943,
    "scene": "635",
    "index": 169,
    "action": 71012,
    "group": "635:60",
    "speaker": "Юма",
    "ja": "……オマエで言うところの",
    "ru": "...Для тебя это называлось бы"
  },
  {
    "id": 111944,
    "scene": "635",
    "index": 170,
    "action": 71084,
    "group": "635:60",
    "speaker": "Юма",
    "ja": "夢だな。",
    "ru": "мечтой."
  },
  {
    "id": 111946,
    "scene": "635",
    "index": 172,
    "action": 71336,
    "group": "635:61",
    "speaker": "#Name[2]",
    "ja": "夢？",
    "ru": "Мечтой?"
  },
  {
    "id": 111948,
    "scene": "635",
    "index": 174,
    "action": 71724,
    "group": "635:62",
    "speaker": "Юма",
    "ja": "オマエの血が特殊だってことは",
    "ru": "Ты ведь и сама понимаешь,"
  },
  {
    "id": 111949,
    "scene": "635",
    "index": 175,
    "action": 71800,
    "group": "635:62",
    "speaker": "Юма",
    "ja": "自分でもわかってんだろ？",
    "ru": "что твоя кровь особенная?"
  },
  {
    "id": 111951,
    "scene": "635",
    "index": 177,
    "action": 72068,
    "group": "635:63",
    "speaker": "#Name[2]",
    "ja": "うん……コーデリアの心臓から",
    "ru": "Да... Она течёт из сердца Корделии,"
  },
  {
    "id": 111952,
    "scene": "635",
    "index": 178,
    "action": 72144,
    "group": "635:63",
    "speaker": "#Name[2]",
    "ja": "流れてる血だから、普通の人とは",
    "ru": "поэтому отличается от крови"
  },
  {
    "id": 111953,
    "scene": "635",
    "index": 179,
    "action": 72220,
    "group": "635:63",
    "speaker": "#Name[2]",
    "ja": "違うんだよね？",
    "ru": "обычного человека, верно?"
  },
  {
    "id": 111955,
    "scene": "635",
    "index": 181,
    "action": 72428,
    "group": "635:64",
    "speaker": "Юма",
    "ja": "そうだ。そしてその血は、",
    "ru": "Да. И эта кровь"
  },
  {
    "id": 111956,
    "scene": "635",
    "index": 182,
    "action": 72500,
    "group": "635:64",
    "speaker": "Юма",
    "ja": "アダムを覚醒させる力を持ってる。",
    "ru": "способна пробудить Адама."
  },
  {
    "id": 111958,
    "scene": "635",
    "index": 184,
    "action": 72776,
    "group": "635:65",
    "speaker": "#Name[2]",
    "ja": "アダム？",
    "ru": "Адама?"
  },
  {
    "id": 111960,
    "scene": "635",
    "index": 186,
    "action": 72980,
    "group": "635:66",
    "speaker": "Юма",
    "ja": "新しい人類を生み出せる、",
    "ru": "Единственного мужчину, способного"
  },
  {
    "id": 111961,
    "scene": "635",
    "index": 187,
    "action": 73052,
    "group": "635:66",
    "speaker": "Юма",
    "ja": "唯一の男だ。そしてそれの女版がイブ",
    "ru": "создать новое человечество. А его женская"
  },
  {
    "id": 111962,
    "scene": "635",
    "index": 188,
    "action": 73132,
    "group": "635:66",
    "speaker": "Юма",
    "ja": "……つまりオマエだ。",
    "ru": "пара - Ева. То есть ты."
  },
  {
    "id": 111964,
    "scene": "635",
    "index": 190,
    "action": 73536,
    "group": "635:67",
    "speaker": "Юма",
    "ja": "つっても、正直オレも難しいことは",
    "ru": "Хотя, если честно, я и сам"
  },
  {
    "id": 111965,
    "scene": "635",
    "index": 191,
    "action": 73616,
    "group": "635:67",
    "speaker": "Юма",
    "ja": "よくわかってねえ。",
    "ru": "не особо понимаю всю эту сложную штуку."
  },
  {
    "id": 111966,
    "scene": "635",
    "index": 192,
    "action": 73680,
    "group": "635:67",
    "speaker": "Юма",
    "ja": "全部あの方の受け売りだからな。",
    "ru": "Это всё слова того человека."
  },
  {
    "id": 111968,
    "scene": "635",
    "index": 194,
    "action": 74092,
    "group": "635:68",
    "speaker": "Юма",
    "ja": "要は、オマエに選ばれた奴は",
    "ru": "Короче, тот, кого выберешь ты,"
  },
  {
    "id": 111969,
    "scene": "635",
    "index": 195,
    "action": 74164,
    "group": "635:68",
    "speaker": "Юма",
    "ja": "すげえ力を得られるってことだ。",
    "ru": "получит огромную силу."
  },
  {
    "id": 111971,
    "scene": "635",
    "index": 197,
    "action": 74576,
    "group": "635:69",
    "speaker": "Юма",
    "ja": "それこそ",
    "ru": "Такую,"
  },
  {
    "id": 111972,
    "scene": "635",
    "index": 198,
    "action": 74632,
    "group": "635:69",
    "speaker": "Юма",
    "ja": "世界を変えられるような、な。",
    "ru": "что сможет изменить мир."
  },
  {
    "id": 111974,
    "scene": "635",
    "index": 200,
    "action": 74904,
    "group": "635:70",
    "speaker": "#Name[2]",
    "ja": "……だから私は、ここに",
    "ru": "...Поэтому меня"
  },
  {
    "id": 111975,
    "scene": "635",
    "index": 201,
    "action": 74972,
    "group": "635:70",
    "speaker": "#Name[2]",
    "ja": "連れて来られた？",
    "ru": "и привезли сюда?"
  },
  {
    "id": 111977,
    "scene": "635",
    "index": 203,
    "action": 75372,
    "group": "635:71",
    "speaker": "Юма",
    "ja": "ああ。でなきゃ逆巻の連中が",
    "ru": "Ага. Иначе кто-то из Сакамаки"
  },
  {
    "id": 111978,
    "scene": "635",
    "index": 204,
    "action": 75444,
    "group": "635:71",
    "speaker": "Юма",
    "ja": "アダムになってただろうからな。",
    "ru": "уже стал бы Адамом."
  },
  {
    "id": 111979,
    "scene": "635",
    "index": 205,
    "action": 75520,
    "group": "635:71",
    "speaker": "Юма",
    "ja": "オレたちはそれを阻止したかった。",
    "ru": "Мы хотели этому помешать."
  },
  {
    "id": 111981,
    "scene": "635",
    "index": 207,
    "action": 76160,
    "group": "635:72",
    "speaker": "#Name[2]",
    "ja": "ユーマくんも",
    "ru": "Юма-кун тоже"
  },
  {
    "id": 111982,
    "scene": "635",
    "index": 208,
    "action": 76220,
    "group": "635:72",
    "speaker": "#Name[2]",
    "ja": "アダムになりたかったの？",
    "ru": "хотел стать Адамом?"
  },
  {
    "id": 111984,
    "scene": "635",
    "index": 210,
    "action": 76628,
    "group": "635:73",
    "speaker": "Юма",
    "ja": "……そうだな。",
    "ru": "...Да."
  },
  {
    "id": 111986,
    "scene": "635",
    "index": 212,
    "action": 76836,
    "group": "635:74",
    "speaker": "Юма",
    "ja": "オレは力とか世界を支配するとか、",
    "ru": "Мне неинтересны ни сила,"
  },
  {
    "id": 111987,
    "scene": "635",
    "index": 213,
    "action": 76916,
    "group": "635:74",
    "speaker": "Юма",
    "ja": "そんなモンに興味はねえが。",
    "ru": "ни власть над миром."
  },
  {
    "id": 111989,
    "scene": "635",
    "index": 215,
    "action": 77136,
    "group": "635:75",
    "speaker": "Юма",
    "ja": "アダムになれば、貴族に勝って",
    "ru": "Но я думал: став Адамом, смогу победить знать"
  },
  {
    "id": 111990,
    "scene": "635",
    "index": 216,
    "action": 77212,
    "group": "635:75",
    "speaker": "Юма",
    "ja": "世界を変えるってボスの夢を代わりに",
    "ru": "и вместо Босса исполнить его мечту"
  },
  {
    "id": 111991,
    "scene": "635",
    "index": 217,
    "action": 77292,
    "group": "635:75",
    "speaker": "Юма",
    "ja": "叶えられると思ったから。",
    "ru": "изменить мир."
  },
  {
    "id": 111993,
    "scene": "635",
    "index": 219,
    "action": 77700,
    "group": "635:76",
    "speaker": "Юма",
    "ja": "……けど、ボスには悪いが、",
    "ru": "...Но, прости меня, Босс,"
  },
  {
    "id": 111994,
    "scene": "635",
    "index": 220,
    "action": 77772,
    "group": "635:76",
    "speaker": "Юма",
    "ja": "どうやらオレはアダムになれねえ",
    "ru": "похоже, Адамом мне"
  },
  {
    "id": 111995,
    "scene": "635",
    "index": 221,
    "action": 77848,
    "group": "635:76",
    "speaker": "Юма",
    "ja": "らしい。",
    "ru": "не стать."
  },
  {
    "id": 111997,
    "scene": "635",
    "index": 223,
    "action": 78100,
    "group": "635:77",
    "speaker": "#Name[2]",
    "ja": "え、どうして……。",
    "ru": "Что? Почему..."
  },
  {
    "id": 111999,
    "scene": "635",
    "index": 225,
    "action": 78500,
    "group": "635:78",
    "speaker": "Юма",
    "ja": "なんとなくわかんだよ。",
    "ru": "Просто чувствую."
  },
  {
    "id": 112000,
    "scene": "635",
    "index": 226,
    "action": 78568,
    "group": "635:78",
    "speaker": "Юма",
    "ja": "今まで足掻いてはきたが……",
    "ru": "До сих пор я ещё пытался..."
  },
  {
    "id": 112001,
    "scene": "635",
    "index": 227,
    "action": 78640,
    "group": "635:78",
    "speaker": "Юма",
    "ja": "そろそろ、悪あがきも底を尽く。",
    "ru": "но, похоже, и эти попытки подходят к концу."
  },
  {
    "id": 112003,
    "scene": "635",
    "index": 229,
    "action": 79052,
    "group": "635:79",
    "speaker": "Юма",
    "ja": "ヴァンパイアになってまで",
    "ru": "Я даже стал вампиром,"
  },
  {
    "id": 112004,
    "scene": "635",
    "index": 230,
    "action": 79124,
    "group": "635:79",
    "speaker": "Юма",
    "ja": "肩代わりしたってのに、この様だ。",
    "ru": "чтобы взять это на себя, а вышло вот так."
  },
  {
    "id": 112005,
    "scene": "635",
    "index": 231,
    "action": 79204,
    "group": "635:79",
    "speaker": "Юма",
    "ja": "今頃笑ってるだろうな、アイツら。",
    "ru": "Наверное, они сейчас смеются."
  },
  {
    "id": 112007,
    "scene": "635",
    "index": 233,
    "action": 79480,
    "group": "635:80",
    "speaker": "#Name[2]",
