  },
  {
    "id": 36266,
    "scene": "334",
    "index": 9,
    "action": 46120,
    "group": "334:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "――これを飲めば、",
    "ru": "――Если я выпью это,"
  },
  {
    "id": 36267,
    "scene": "334",
    "index": 10,
    "action": 46184,
    "group": "334:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "ライトくんを助けられるのだったら、",
    "ru": "и так смогу помочь Райто-куну,"
  },
  {
    "id": 36268,
    "scene": "334",
    "index": 11,
    "action": 46264,
    "group": "334:3",
    "speaker": "Юи (мысли, девушка)",
    "ja": "私は……。",
    "ru": "то я…"
  },
  {
    "id": 36270,
    "scene": "334",
    "index": 14,
    "action": 47488,
    "group": "334:4",
    "speaker": "Рейджи",
    "ja": "さあ、どうするのです？",
    "ru": "Ну же, что вы будете делать?"
  },
  {
    "id": 36272,
    "scene": "334",
    "index": 16,
    "action": 47628,
    "group": "334:5",
    "speaker": "#Name[2]",
    "ja": "私は……。",
    "ru": "Я…"
  },
  {
    "id": 36274,
    "scene": "334",
    "index": 18,
    "action": 48548,
    "group": "334:6",
    "speaker": "Райто",
    "ja": "ビッチちゃん、レイジに",
    "ru": "Стервочка, не дай Рейджи"
