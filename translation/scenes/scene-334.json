  },
  {
    "id": 36262,
    "scene": "334",
    "index": 3,
    "action": 45712,
    "group": "334:1",
    "speaker": "Юи (мысли, девушка)",
    "ja": "ライトくんが苦しむ原因がなくなる。",
    "ru": "причина страданий Райто-куна пропадёт."
