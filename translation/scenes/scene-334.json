  {
    "id": 36300,
    "scene": "334",
    "index": 44,
    "action": 52908,
    "group": "334:14",
    "speaker": "Райто",
    "ja": "こうじゃないでしょう？　んふ。",
    "ru": "таким, правда? Н-фу."
  },
  {
    "id": 36302,
    "scene": "334",
    "index": 46,
    "action": 53256,
    "group": "334:15",
    "speaker": "Райто",
    "ja": "だから……。",
    "ru": "Поэтому…"
  },
  {
    "id": 36304,
    "scene": "334",
    "index": 48,
    "action": 53512,
    "group": "334:16",
    "speaker": "#Name[2]",
    "ja": "ライトくんが……楽になるなら。",
    "ru": "Если Райто-куну… станет легче."
  },
  {
    "id": 36306,
    "scene": "334",
    "index": 50,
    "action": 53928,
    "group": "334:17",
    "speaker": "Райто",
    "ja": "っ……？　楽になる？",
    "ru": "Х…? Станет легче?"
