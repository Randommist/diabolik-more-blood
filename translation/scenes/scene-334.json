    "scene": "334",
    "index": 91,
    "action": 59192,
    "group": "334:30",
    "speaker": "#Name[2]",
    "ja": "っ……。",
    "ru": "Х…"
  },
  {
    "id": 36349,
    "scene": "334",
    "index": 93,
    "action": 59908,
    "group": "334:31",
    "speaker": "Райто",
    "ja": "っ……ゞ　何をしてるの、",
    "ru": "Х…? Что ты делаешь,"
  },
  {
