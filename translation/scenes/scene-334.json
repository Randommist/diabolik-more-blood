  {
    "id": 36275,
    "scene": "334",
    "index": 19,
    "action": 48616,
    "group": "334:6",
    "speaker": "Райто",
    "ja": "誘導されないでよ。",
    "ru": "собой манипулировать."
  },
  {
    "id": 36277,
    "scene": "334",
    "index": 21,
    "action": 48828,
    "group": "334:7",
    "speaker": "Райто",
    "ja": "キミがどうとかそういう問題じゃない。",
    "ru": "Дело вовсе не в тебе и не в чём-то подобном."
  },
  {
    "id": 36278,
    "scene": "334",
    "index": 22,
    "action": 48912,
    "group": "334:7",
    "speaker": "Райто",
    "ja": "これは、ボク自身の問題だ。",
    "ru": "Это моя собственная проблема."
  },
  {
    "id": 36280,
    "scene": "334",
    "index": 24,
    "action": 49180,
    "group": "334:8",
    "speaker": "#Name[2]",
    "ja": "…………。",
    "ru": "…………。"
  },
  {
    "id": 36282,
    "scene": "334",
    "index": 26,
    "action": 50220,
    "group": "334:8",
    "speaker": "#Name[2]",
    "ja": "ライトくんだけの問題じゃないよ。",
    "ru": "Это не только твоя проблема, Райто-кун."
  },
  {
    "id": 36283,
    "scene": "334",
    "index": 27,
    "action": 50300,
    "group": "334:8",
    "speaker": "#Name[2]",
    "ja": "私にだって関係あることでしょ？",
    "ru": "Это ведь касается и меня, разве нет?"
  },
  {
    "id": 36285,
    "scene": "334",
    "index": 29,
    "action": 50812,
    "group": "334:9",
    "speaker": "#Name[2]",
    "ja": "それはそうかもしれない。",
    "ru": "Может, это и так."
  },
  {
    "id": 36287,
    "scene": "334",
    "index": 31,
    "action": 50956,
    "group": "334:10",
    "speaker": "#Name[2]",
    "ja": "……けど、私にも関わらせて。",
    "ru": "…Но позволь и мне участвовать."
  },
  {
    "id": 36288,
    "scene": "334",
    "index": 32,
    "action": 51032,
    "group": "334:10",
    "speaker": "#Name[2]",
    "ja": "一人で決めようとしないでほしい……。",
    "ru": "Не пытайся решать всё в одиночку…"
  },
  {
    "id": 36290,
    "scene": "334",
    "index": 34,
    "action": 51552,
    "group": "334:11",
    "speaker": "#Name[2]",
    "ja": "私は、これ以上ライトくんが",
    "ru": "Я не хочу больше видеть,"
  },
  {
    "id": 36291,
    "scene": "334",
    "index": 35,
    "action": 51624,
    "group": "334:11",
    "speaker": "#Name[2]",
    "ja": "苦しむのを見たくないよ……。",
    "ru": "как ты страдаешь, Райто-кун…"
  },
  {
    "id": 36293,
    "scene": "334",
    "index": 37,
    "action": 52040,
    "group": "334:12",
    "speaker": "Райто",
    "ja": "……っ……うるさいなぁ。",
    "ru": "…Х… как же ты надоедлива."
  },
  {
    "id": 36295,
    "scene": "334",
    "index": 39,
    "action": 52452,
    "group": "334:13",
    "speaker": "Райто",
    "ja": "今、ボクは驚くほどに貪欲に",
    "ru": "Сейчас я до удивления жаден…"
  },
  {
    "id": 36296,
    "scene": "334",
    "index": 40,
    "action": 52524,
    "group": "334:13",
    "speaker": "Райто",
    "ja": "なってる……キミの血を吸って吸って",
    "ru": "Всё пил бы и пил твою кровь,"
  },
  {
    "id": 36297,
    "scene": "334",
    "index": 41,
    "action": 52604,
    "group": "334:13",
    "speaker": "Райто",
    "ja": "出来ることなら永遠に吸っていたい。",
    "ru": "и если бы мог, пил бы вечно."
  },
  {
    "id": 36299,
    "scene": "334",
    "index": 43,
    "action": 52832,
    "group": "334:14",
    "speaker": "Райто",
    "ja": "さすがのボクだって……普段から",
    "ru": "Даже я… обычно не бываю"
