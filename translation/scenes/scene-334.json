  {
    "id": 36307,
    "scene": "334",
    "index": 51,
    "action": 53996,
    "group": "334:17",
    "speaker": "Райто",
    "ja": "どういう意味？",
    "ru": "Что это значит?"
  },
  {
    "id": 36309,
    "scene": "334",
    "index": 53,
    "action": 54128,
    "group": "334:18",
    "speaker": "#Name[2]",
    "ja": "私の血を吸いたいって気持ちを、",
    "ru": "Это желание пить мою кровь"
  },
  {
    "id": 36310,
    "scene": "334",
    "index": 54,
    "action": 54204,
    "group": "334:18",
    "speaker": "#Name[2]",
    "ja": "ライトくんは『特別』だって思ってる。",
    "ru": "Райто-кун считает «особенным»."
  },
  {
    "id": 36312,
    "scene": "334",
    "index": 56,
    "action": 54484,
    "group": "334:19",
    "speaker": "#Name[2]",
    "ja": "だから、吸いたくないんでしょ？",
    "ru": "Поэтому ты и не хочешь пить, верно?"
  },
  {
    "id": 36313,
    "scene": "334",
    "index": 57,
    "action": 54560,
    "group": "334:19",
    "speaker": "#Name[2]",
    "ja": "ライトくんには、『特別』はないから。",
