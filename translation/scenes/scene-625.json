    "group": "625:39",
    "speaker": "Главарь",
    "ja": "おかげさまでなァ。",
    "ru": "Твоими молитвами."
  },
  {
    "id": 109191,
    "scene": "625",
    "index": 110,
    "action": 60600,
    "group": "625:40",
    "speaker": "Беа",
    "ja": "今度はなんだ。めちゃくちゃの粉々に",
    "ru": "И зачем приперся? Захотел,"
  },
  {
    "id": 109192,
    "scene": "625",
    "index": 111,
    "action": 60680,
    "group": "625:40",
    "speaker": "Беа",
    "ja": "なるまで折ってもらいに来たのか？",
    "ru": "чтобы тебе переломали все кости подчистую?"
  },
  {
    "id": 109194,
    "scene": "625",
    "index": 113,
    "action": 60916,
    "group": "625:41",
    "speaker": "Главарь",
    "ja": "おう、そうだぜ。ただし――",
    "ru": "Ага, именно. Вот только..."
  },
  {
    "id": 109196,
    "scene": "625",
    "index": 115,
    "action": 61256,
    "group": "625:42",
    "speaker": "Главарь",
    "ja": "粉々にされんのはお前だがなァ。",
    "ru": "В порошок сегодня сотрут тебя."
  },
  {
    "id": 109198,
    "scene": "625",
    "index": 117,
    "action": 61480,
    "group": "625:43",
    "speaker": "Беа",
    "ja": "……ひとりじゃ勝てねえからって",
    "ru": "...Собрал сброд, потому что в одиночку кишка тонка?"
  },
  {
    "id": 109199,
    "scene": "625",
    "index": 118,
    "action": 61556,
    "group": "625:43",
    "speaker": "Беа",
    "ja": "寄せ集めたのか？　ゼロが何人",
    "ru": "Сколько бы нулей вы ни сложили,"
  },
  {
    "id": 109200,
    "scene": "625",
    "index": 119,
    "action": 61632,
    "group": "625:43",
    "speaker": "Беа",
    "ja": "いようが結果は同じだけどよ。",
    "ru": "итог все равно один."
  },
  {
    "id": 109202,
    "scene": "625",
    "index": 121,
    "action": 61864,
    "group": "625:44",
    "speaker": "Главарь",
    "ja": "……相変わらず",
    "ru": "...А ты по-прежнему"
  },
  {
    "id": 109203,
    "scene": "625",
    "index": 122,
    "action": 61924,
    "group": "625:44",
    "speaker": "Главарь",
    "ja": "口の減らねえ野郎だ。",
    "ru": "слишком много треплешь языком."
  },
  {
    "id": 109205,
    "scene": "625",
    "index": 124,
    "action": 62148,
    "group": "625:45",
    "speaker": "Главарь",
    "ja": "さて、命日の延長はここまでだ。",
    "ru": "Ну все, твоя отсрочка закончилась."
  },
  {
    "id": 109206,
    "scene": "625",
    "index": 125,
    "action": 62224,
    "group": "625:45",
    "speaker": "Главарь",
    "ja": "お前のボスが死んだあの日から随分と",
    "ru": "Со дня смерти твоего босса утекло немало времени,"
  },
  {
    "id": 109207,
    "scene": "625",
    "index": 126,
    "action": 62304,
    "group": "625:45",
    "speaker": "Главарь",
    "ja": "経っちまったが、ようやくだぜ。",
    "ru": "но наконец-то этот миг настал."
  },
  {
    "id": 109209,
    "scene": "625",
    "index": 128,
    "action": 62892,
    "group": "625:46",
    "speaker": "Беа",
    "ja": "くそが……よりによって今日かよ。",
    "ru": "Черт подери... именно сегодня, а?"
  },
  {
    "id": 109210,
    "scene": "625",
    "index": 129,
    "action": 62972,
    "group": "625:46",
    "speaker": "Беа",
    "ja": "間が悪すぎんだよ、テメーは。",
    "ru": "Вечно ты не вовремя лезешь, скотина."
  },
  {
    "id": 109212,
    "scene": "625",
    "index": 131,
    "action": 63204,
    "group": "625:47",
    "speaker": "Главарь",
    "ja": "お喋りは終わりだ！　あの世で",
    "ru": "Хватит болтать! На том свете"
  },
  {
    "id": 109213,
    "scene": "625",
    "index": 132,
    "action": 63280,
    "group": "625:47",
    "speaker": "Главарь",
    "ja": "大好きなボスが待ってるぜ！",
    "ru": "тебя уже заждался твой драгоценный босс!"
  },
  {
    "id": 109215,
    "scene": "625",
    "index": 134,
    "action": 63500,
    "group": "625:48",
    "speaker": "Беа",
    "ja": "チッ……！",
    "ru": "Тц!.."
  },
  {
    "id": 109217,
    "scene": "625",
    "index": 136,
    "action": 64148,
    "group": "625:49",
    "speaker": "Коу",
    "ja": "――ベーアゝ",
    "ru": "-- Бе-эа!"
  },
  {
    "id": 109219,
    "scene": "625",
    "index": 138,
    "action": 64552,
    "group": "625:50",
    "speaker": "Беа",
    "ja": "コウゞ",
    "ru": "Коу!"
  },
  {
    "id": 109221,
    "scene": "625",
    "index": 140,
    "action": 65196,
    "group": "625:51",
    "speaker": "Руки",
    "ja": "時間になっても現れないと思えば、",
    "ru": "Мы ждем тебя к назначенному часу, а ты"
  },
  {
    "id": 109222,
    "scene": "625",
    "index": 141,
    "action": 65276,
    "group": "625:51",
    "speaker": "Руки",
    "ja": "何をやってるんだ、お前は！",
    "ru": "чем здесь занимаешься?!"
  },
  {
    "id": 109224,
    "scene": "625",
    "index": 143,
    "action": 65692,
    "group": "625:52",
    "speaker": "Беа",
    "ja": "オレが知るかよ！",
    "ru": "Да откуда я знаю!"
  },
  {
    "id": 109225,
    "scene": "625",
    "index": 144,
    "action": 65756,
    "group": "625:52",
    "speaker": "Беа",
    "ja": "絡んできたのはコイツらだ！",
    "ru": "Это они до меня докопались!"
  },
  {
    "id": 109227,
    "scene": "625",
    "index": 146,
    "action": 66172,
    "group": "625:53",
    "speaker": "Коу",
    "ja": "絡まれるほうにも問題はあると",
    "ru": "По-моему, тот, до кого докапываются,"
  },
  {
    "id": 109228,
    "scene": "625",
    "index": 147,
    "action": 66248,
    "group": "625:53",
    "speaker": "Коу",
    "ja": "思うけどね！",
    "ru": "тоже виноват!"
  },
  {
    "id": 109230,
    "scene": "625",
    "index": 149,
    "action": 66456,
    "group": "625:54",
    "speaker": "Руки",
    "ja": "そんなことはどうでもいい！",
    "ru": "Не имеет значения!"
  },
  {
    "id": 109231,
    "scene": "625",
    "index": 150,
    "action": 66528,
    "group": "625:54",
    "speaker": "Руки",
    "ja": "さっさと片付けるぞ！",
    "ru": "Разберемся с ними по-быстрому!"
  },
  {
    "id": 109232,
    "scene": "625",
    "index": 151,
    "action": 66596,
    "group": "625:54",
    "speaker": "Руки",
    "ja": "このチャンスを逃したら終わりだ！",
    "ru": "Упустим этот шанс - и нам конец!"
  },
  {
    "id": 109234,
    "scene": "625",
    "index": 153,
    "action": 66824,
    "group": "625:55",
    "speaker": "Беа",
    "ja": "わかってる……っつーのっ！",
    "ru": "Да понял я... черт бы вас побрал!"
  },
  {
    "id": 109236,
    "scene": "625",
    "index": 155,
    "action": 67156,
    "group": "625:56",
    "speaker": "Руки",
    "ja": "こうなったらこの混乱を利用する！",
    "ru": "Раз так, используем эту суматоху себе на пользу!"
  },
  {
    "id": 109237,
    "scene": "625",
    "index": 156,
    "action": 67236,
    "group": "625:56",
    "speaker": "Руки",
    "ja": "コウ、火をつけるのはお前がやれ！",
    "ru": "Коу, поджог на тебе!"
  },
  {
    "id": 109239,
    "scene": "625",
    "index": 158,
    "action": 67660,
    "group": "625:57",
    "speaker": "Коу",
    "ja": "了解！",
    "ru": "Принято!"
  },
  {
    "id": 109241,
    "scene": "625",
    "index": 160,
    "action": 68012,
    "group": "625:58",
    "speaker": "Руки",
    "ja": "俺は看守を片っ端から連れて来る。",
    "ru": "Я приведу сюда всех надзирателей до единого."
  },
  {
    "id": 109242,
    "scene": "625",
    "index": 161,
    "action": 68092,
    "group": "625:58",
    "speaker": "Руки",
    "ja": "お前たちは出来るだけ騒げ！",
    "ru": "А вы шумите как можно громче!"
  },
  {
    "id": 109243,
    "scene": "625",
    "index": 162,
    "action": 68164,
    "group": "625:58",
    "speaker": "Руки",
    "ja": "ただし絶対に押さえ込まれるなよ！",
    "ru": "Но ни в коем случае не дайте себя скрутить!"
  },
  {
    "id": 109245,
    "scene": "625",
    "index": 164,
    "action": 68392,
    "group": "625:59",
    "speaker": "Руки",
    "ja": "俺が合図をしたら一気に",
    "ru": "Как только я подам сигнал,"
  },
  {
    "id": 109246,
    "scene": "625",
    "index": 165,
    "action": 68460,
    "group": "625:59",
    "speaker": "Руки",
    "ja": "門を抜ける！　いいな！",
    "ru": "все разом прорываемся к воротам! Поняли?!"
  },
  {
    "id": 109248,
    "scene": "625",
    "index": 167,
    "action": 68872,
    "group": "625:60",
    "speaker": "Беа",
    "ja": "楽勝だ！",
    "ru": "Проще простого!"
  },
  {
    "id": 109250,
    "scene": "625",
    "index": 169,
    "action": 69520,
    "group": "625:61",
    "speaker": "Азуса",
    "ja": "俺は殴られる役でいい……？",
    "ru": "А мне можно быть тем, кого бьют?.."
  },
  {
    "id": 109252,
    "scene": "625",
    "index": 171,
    "action": 69936,
    "group": "625:62",
    "speaker": "Беа",
    "ja": "そんな役はねえ！",
    "ru": "Нет у нас такой роли!"
  },
  {
    "id": 109253,
    "scene": "625",
    "index": 172,
    "action": 70000,
    "group": "625:62",
    "speaker": "Беа",
    "ja": "オレたちは殴ってぶちのめす側だ！",
    "ru": "Это мы тут всем рожи начищаем!"
  },
  {
    "id": 109254,
    "scene": "625",
    "index": 173,
    "action": 70080,
    "group": "625:62",
    "speaker": "Беа",
    "ja": "――行くぜゝ",
    "ru": "-- Погнали!"
  },
  {
    "id": 109255,
    "scene": "625",
    "index": 174,
    "action": 70736,
    "group": "625:63",
    "speaker": "Беа",
    "ja": "――結局、何日もかけて練った計画は",
    "ru": "В итоге многодневный план"
  },
  {
    "id": 109256,
    "scene": "625",
    "index": 175,
    "action": 70816,
    "group": "625:63",
    "speaker": "Беа",
    "ja": "その通りにとはいかなかった。",
    "ru": "пошёл совсем не так, как задумано."
  },
  {
    "id": 109257,
    "scene": "625",
    "index": 177,
    "action": 70956,
    "group": "625:64",
    "speaker": "Беа",
    "ja": "だけど事は上手い具合に進み、",
    "ru": "Однако обстоятельства сыграли нам на руку,"
  },
  {
    "id": 109258,
    "scene": "625",
    "index": 178,
    "action": 71032,
    "group": "625:64",
    "speaker": "Беа",
    "ja": "オレたちは地獄から這い出すことに",
    "ru": "и нам удалось выкарабкаться"
  },
  {
    "id": 109259,
    "scene": "625",
    "index": 179,
    "action": 71112,
    "group": "625:64",
    "speaker": "Беа",
    "ja": "成功した。",
    "ru": "из этой преисподней."
  },
  {
    "id": 109260,
    "scene": "625",
    "index": 181,
    "action": 71524,
    "group": "625:65",
    "speaker": "Беа",
    "ja": "――外には広がっていたのは抜ける",
    "ru": "-- Снаружи простиралась бездонная,"
  },
  {
    "id": 109261,
    "scene": "625",
    "index": 182,
    "action": 71604,
    "group": "625:65",
    "speaker": "Беа",
    "ja": "ような青空。",
    "ru": "пронзительная синева."
  },
  {
    "id": 109262,
    "scene": "625",
    "index": 184,
    "action": 71728,
    "group": "625:66",
    "speaker": "Беа",
    "ja": "どうやら今日は晴れていたらしい。",
    "ru": "Похоже, сегодня выдался ясный день."
  },
  {
    "id": 109263,
    "scene": "625",
    "index": 186,
    "action": 71872,
    "group": "625:67",
    "speaker": "Беа",
    "ja": "空を見るのは久々だ。",
    "ru": "Давно я не видел неба."
  },
  {
    "id": 109264,
    "scene": "625",
    "index": 187,
    "action": 71940,
    "group": "625:67",
    "speaker": "Беа",
    "ja": "そのせいなのか、なんの変哲もない",
    "ru": "Наверное, поэтому даже голубое небо"
  },
  {
    "id": 109265,
    "scene": "625",
    "index": 188,
    "action": 72020,
    "group": "625:67",
    "speaker": "Беа",
    "ja": "青空と白い雲が妙にきれいに見える。",
    "ru": "и белые облака казались прекрасными."
  },
  {
    "id": 109266,
    "scene": "625",
    "index": 190,
    "action": 72164,
    "group": "625:68",
    "speaker": "Беа",
    "ja": "オレはつい、世界って美しいんだなと",
    "ru": "Я даже невольно подумал о том,"
  },
  {
    "id": 109267,
    "scene": "625",
    "index": 191,
    "action": 72244,
    "group": "625:68",
    "speaker": "Беа",
    "ja": "思った。",
    "ru": "как прекрасен этот мир."
  },
  {
    "id": 109268,
    "scene": "625",
    "index": 193,
    "action": 72364,
    "group": "625:69",
    "speaker": "Беа",
    "ja": "牢獄から抜け出そうが、これから",
    "ru": "И пусть мы вырвались из тюрьмы, мир,"
  },
  {
    "id": 109269,
    "scene": "625",
    "index": 194,
    "action": 72440,
    "group": "625:69",
    "speaker": "Беа",
    "ja": "オレたちが生きていく世界が",
    "ru": "в котором нам предстоит жить дальше,"
  },
  {
    "id": 109270,
    "scene": "625",
    "index": 195,
    "action": 72512,
    "group": "625:69",
    "speaker": "Беа",
    "ja": "腐っていることに違いはないのに。",
    "ru": "все так же безнадежно прогнил."
  },
  {
    "id": 109271,
    "scene": "625",
    "index": 197,
    "action": 72656,
    "group": "625:70",
    "speaker": "Беа",
    "ja": "オレはこの国を、世界を変えてやる。",
    "ru": "Я изменю эту страну, изменю этот мир."
  },
  {
    "id": 109272,
    "scene": "625",
    "index": 198,
    "action": 72736,
    "group": "625:70",
    "speaker": "Беа",
    "ja": "そのために無我夢中で走ってるんだ。",
    "ru": "Ради этого я сейчас и бегу сломя голову."
  },
  {
    "id": 109273,
    "scene": "625",
    "index": 200,
    "action": 72880,
    "group": "625:71",
    "speaker": "Беа",
    "ja": "それなのに、晴れた空はやっぱり",
    "ru": "И все же ясное небо было таким прекрасным,"
  },
  {
    "id": 109274,
    "scene": "625",
    "index": 201,
    "action": 72956,
    "group": "625:71",
    "speaker": "Беа",
    "ja": "きれいで、オレは上を仰ぐ度に",
    "ru": "что каждый раз, поднимая на него глаза,"
  },
  {
    "id": 109275,
    "scene": "625",
    "index": 202,
    "action": 73032,
    "group": "625:71",
    "speaker": "Беа",
    "ja": "何故か泣きそうな気持ちになった。",
    "ru": "я почему-то был готов расплакаться."
  },
  {
    "id": 109277,
    "scene": "625",
    "index": 204,
    "action": 74380,
    "group": "625:72",
    "speaker": "Руки",
    "ja": "最近あれとはどうなってるんだ？",
    "ru": "Как у тебя в последнее время с ней?"
  },
  {
    "id": 109279,
    "scene": "625",
    "index": 206,
    "action": 75036,
    "group": "625:73",
    "speaker": "Юма",
    "ja": "……別に、どうもねえ。",
    "ru": "...Да никак, нормально."
  },
  {
    "id": 109281,
    "scene": "625",
    "index": 208,
    "action": 75252,
    "group": "625:74",
    "speaker": "Руки",
    "ja": "血は吸っているんだろう？",
    "ru": "Кровь ты пьешь, верно?"
  },
  {
    "id": 109282,
    "scene": "625",
    "index": 209,
    "action": 75324,
    "group": "625:74",
    "speaker": "Руки",
    "ja": "兆候はないのか？　アダムの。",
    "ru": "И никаких признаков? Признаков Адама."
  },
  {
    "id": 109284,
    "scene": "625",
    "index": 211,
    "action": 75736,
    "group": "625:75",
    "speaker": "Юма",
    "ja": "……ないんじゃねえの。",
    "ru": "...Да вроде нет."
  },
  {
    "id": 109285,
    "scene": "625",
    "index": 212,
    "action": 75804,
    "group": "625:75",
    "speaker": "Юма",
    "ja": "知らねえけど。",
    "ru": "Откуда мне знать."
  },
  {
    "id": 109287,
    "scene": "625",
    "index": 214,
    "action": 76204,
    "group": "625:76",
    "speaker": "Руки",
    "ja": "……ユーマ。",
    "ru": "...Юма."
  },
  {
    "id": 109289,
    "scene": "625",
    "index": 216,
    "action": 76600,
    "group": "625:77",
    "speaker": "Юма",
    "ja": "うるせえな、わかってんだよ！",
    "ru": "Заткнись, сам все знаю!"
  },
  {
    "id": 109290,
    "scene": "625",
    "index": 217,
    "action": 76676,
    "group": "625:77",
    "speaker": "Юма",
    "ja": "いちいち言うな、うぜえ！",
    "ru": "Не зуди над ухом, бесишь!"
  },
  {
    "id": 109292,
    "scene": "625",
    "index": 219,
    "action": 77084,
    "group": "625:78",
    "speaker": "Руки",
    "ja": "……焦ってるのか？",
    "ru": "...Нервничаешь?"
  },
  {
    "id": 109294,
    "scene": "625",
