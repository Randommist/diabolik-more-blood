  },
  {
    "id": 111581,
    "scene": "634",
    "index": 94,
    "action": 60096,
    "group": "634:35",
    "speaker": "Юма",
    "ja": "あるような気はしてたんだけどな。",
    "ru": "будто я его откуда-то помню."
