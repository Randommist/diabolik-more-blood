    "id": 111601,
    "scene": "634",
    "index": 114,
    "action": 62660,
    "group": "634:41",
    "speaker": "Юма",
    "ja": "つっても、人間だった頃のオレが",
    "ru": "Хотя трудно представить, чтобы я,"
