  {
    "id": 111595,
    "scene": "634",
    "index": 108,
    "action": 61696,
    "group": "634:39",
    "speaker": "Юма",
    "ja": "まあ、確証はねえ。",
    "ru": "Но уверенности у меня нет."
  },
  {
    "id": 111597,
    "scene": "634",
    "index": 110,
    "action": 62096,
    "group": "634:40",
    "speaker": "Юма",
    "ja": "だけどもしアイツなら、どうして",
    "ru": "Но если это он, тогда почему"
