    "id": 111588,
    "scene": "634",
    "index": 101,
    "action": 60936,
    "group": "634:37",
    "speaker": "Юма",
    "ja": "気になってよ。",
    "ru": "вот и стало интересно."
  },
  {
    "id": 111590,
    "scene": "634",
    "index": 103,
    "action": 61068,
    "group": "634:38",
    "speaker": "#Name[2]",
    "ja": "それってつまり、子どもの頃の",
    "ru": "То есть Шу-сан"
